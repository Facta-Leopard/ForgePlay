+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stddef.h>
+#include <stdlib.h>
+
+#include "macdrv.h"
+#include "ntuser.h"
+
+/*
+ * Metal renderers discover this table with dlsym().  Keep this layout stable:
+ * it is an ABI boundary, not a mirror of struct macdrv_win_data.
+ */
+struct macdrv_metal_surface_functions
+{
+    void (*init_display_devices)(BOOL);
+    void *(*get_win_data)(HWND);
+    void (*release_win_data)(void *);
+    macdrv_window (*get_cocoa_window)(HWND, BOOL);
+    macdrv_metal_device (*create_metal_device)(void);
+    void (*release_metal_device)(macdrv_metal_device);
+    macdrv_metal_view (*view_create_metal_view)(macdrv_view, macdrv_metal_device);
+    macdrv_metal_layer (*view_get_metal_layer)(macdrv_metal_view);
+    void (*view_release_metal_view)(macdrv_metal_view);
+    void (*on_main_thread)(void *);
+};
+
+/*
+ * Renderer clients only observe this four-pointer prefix.  The owner is kept
+ * after that prefix so Wine's private window-data layout remains private and
+ * can continue to evolve independently.
+ */
+struct macdrv_metal_surface_window_data
+{
+    HWND hwnd;
+    macdrv_window cocoa_window;
+    macdrv_view cocoa_view;
+    macdrv_view client_cocoa_view;
+    struct macdrv_win_data *owner;
+};
+
+C_ASSERT(offsetof(struct macdrv_metal_surface_window_data, client_cocoa_view) == 3 * sizeof(void *));
+C_ASSERT(offsetof(struct macdrv_metal_surface_functions, view_create_metal_view) == 6 * sizeof(void *));
+C_ASSERT(offsetof(struct macdrv_metal_surface_functions, view_release_metal_view) == 8 * sizeof(void *));
+
+static void metal_surface_init_display_devices(BOOL force)
+{
+    UINT32 path_count, mode_count;
+
+    if (force)
+        NtUserCallNoParam(NtUserCallNoParam_DisplayModeChanged);
+    else
+        NtUserGetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &path_count, &mode_count);
+}
+
+static void *metal_surface_get_win_data(HWND hwnd)
+{
+    struct macdrv_metal_surface_window_data *contract;
+    struct macdrv_win_data *data;
+
+    if (!(data = get_win_data(hwnd))) return NULL;
+    if (!(contract = calloc(1, sizeof(*contract))))
+    {
+        release_win_data(data);
+        return NULL;
+    }
+
+    contract->hwnd = data->hwnd;
+    contract->cocoa_window = data->cocoa_window;
+    contract->cocoa_view = data->cocoa_window ? macdrv_window_get_content_view(data->cocoa_window) : NULL;
+    contract->client_cocoa_view = data->client_view ? data->client_view : contract->cocoa_view;
+    contract->owner = data;
+    return contract;
+}
+
+static void metal_surface_release_win_data(void *opaque)
+{
+    struct macdrv_metal_surface_window_data *contract = opaque;
+
+    if (!contract) return;
+    release_win_data(contract->owner);
+    free(contract);
+}
+
+DECLSPEC_EXPORT const struct macdrv_metal_surface_functions macdrv_functions =
+{
+    metal_surface_init_display_devices,
+    metal_surface_get_win_data,
+    metal_surface_release_win_data,
+    macdrv_get_cocoa_window,
+    macdrv_create_metal_device,
+    macdrv_release_metal_device,
+    macdrv_view_create_metal_view,
+    macdrv_view_get_metal_layer,
+    macdrv_view_release_metal_view,
+    macdrv_on_main_thread,
+};
