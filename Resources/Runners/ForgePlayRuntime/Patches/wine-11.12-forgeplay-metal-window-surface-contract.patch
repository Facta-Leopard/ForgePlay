+/***********************************************************************
+ *              macdrv_on_main_thread
+ *
+ * C ABI adapter for native renderer clients that pass a dispatch block
+ * through the public Mac-driver function table.
+ */
+void macdrv_on_main_thread(void *opaque)
+{
+    dispatch_block_t block = (dispatch_block_t)opaque;
+
+    if (block) OnMainThread(block);
+}
