diff --git a/dlls/winemac.drv/metal_surface_contract.c b/dlls/winemac.drv/metal_surface_contract.c
new file mode 100644
index 0000000000000000000000000000000000000000..e071beae1c2847e3f36cb18b8b92a3f7459f0a2c
--- /dev/null
+++ b/dlls/winemac.drv/metal_surface_contract.c
@@ -0,0 +1,120 @@
+/*
+ * Public Metal renderer window-surface contract for the Mac driver
+ *
+ * Copyright 2026 ForgePlay contributors
+ *
