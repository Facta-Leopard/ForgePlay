+/***********************************************************************
+ *           is_forgeplay_steam_game_path
+ *
+ * Steam libraries always launch the first game or launcher executable
+ * below steamapps/common. Renderer state inherited by later descendants
+ * remains process-local and never reaches Steam or Steam WebHelper.
+ */
+static BOOL is_forgeplay_steam_game_path( const WCHAR *path )
+{
+    const WCHAR *cursor;
+
+    if (!path) return FALSE;
+    for (cursor = path; *cursor; ++cursor)
+    {
+        if (*cursor != L'\\' && *cursor != L'/') continue;
+        if (wcslen( cursor ) < 18) return FALSE;
+        if (!wcsnicmp( cursor + 1, L"steamapps", 9 ) &&
+            (cursor[10] == L'\\' || cursor[10] == L'/') &&
+            !wcsnicmp( cursor + 11, L"common", 6 ) &&
+            (cursor[17] == L'\\' || cursor[17] == L'/')) return TRUE;
+    }
+    return FALSE;
+}
+
+
+static const WCHAR *forgeplay_path_basename( const WCHAR *path )
+{
+    const WCHAR *cursor, *basename = path;
+
+    if (!path) return NULL;
+    for (cursor = path; *cursor; ++cursor)
+        if (*cursor == L'\\' || *cursor == L'/') basename = cursor + 1;
+    return basename;
+}
+
+
+/* Infrastructure processes must never receive a game renderer even if a
+ * game launcher starts one while carrying the game-lineage token. */
+static BOOL is_forgeplay_game_renderer_excluded_role( const WCHAR *path )
+{
+    static const WCHAR *excluded_names[] =
+    {
+        L"steam.exe",
+        L"steamwebhelper.exe",
+        L"steamservice.exe",
+        L"crashhandler.exe",
+        L"crashhandler64.exe",
+    };
+    const WCHAR *basename = forgeplay_path_basename( path );
+    unsigned int i;
+
+    if (!basename || !*basename) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(excluded_names); ++i)
+        if (!wcsicmp( basename, excluded_names[i] )) return TRUE;
+    return FALSE;
+}
