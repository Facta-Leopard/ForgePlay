+static void forgeplay_scan_game_renderer_imports( const WCHAR *filename, const WCHAR *cur_dir,
+                                                  struct forgeplay_game_renderer_import_scan *scan )
+{
+    WCHAR *relative_path = NULL;
+    const WCHAR *open_path = filename;
+    HANDLE file = INVALID_HANDLE_VALUE, mapping = NULL;
+    LARGE_INTEGER size;
+    BYTE *bytes = NULL;
+    SIZE_T file_size, nt_offset, optional_offset, section_offset, directory_offset;
+    WORD section_count, optional_size, optional_magic;
+    DWORD size_of_headers, directory_count, import_rva, import_size, delay_rva, delay_size;
+
+    memset( scan, 0, sizeof(*scan) );
+    file = CreateFileW( open_path, GENERIC_READ,
+                        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                        NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE && cur_dir && filename && filename[0] &&
+        !(filename[1] == L':' || filename[0] == L'\\' || filename[0] == L'/'))
+    {
+        SIZE_T length = wcslen( cur_dir ) + wcslen( filename ) + 2;
+        if ((relative_path = HeapAlloc( GetProcessHeap(), 0, length * sizeof(WCHAR) )))
+        {
+            swprintf( relative_path, length, L"%s\\%s", cur_dir, filename );
+            open_path = relative_path;
+            file = CreateFileW( open_path, GENERIC_READ,
+                                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                                NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+        }
+    }
+    if (file == INVALID_HANDLE_VALUE || !GetFileSizeEx( file, &size ) ||
+        size.QuadPart <= 0 || (ULONGLONG)size.QuadPart > ~(SIZE_T)0)
+        goto done;
+    file_size = size.QuadPart;
+    if (!(mapping = CreateFileMappingW( file, NULL, PAGE_READONLY, 0, 0, NULL ))) goto done;
+    if (!(bytes = MapViewOfFile( mapping, FILE_MAP_READ, 0, 0, 0 ))) goto done;
+
+    if (!forgeplay_file_range_is_valid( 0, 0x40, file_size ) ||
+        forgeplay_read_word( bytes, 0 ) != IMAGE_DOS_SIGNATURE)
+        goto done;
+    nt_offset = forgeplay_read_dword( bytes, 0x3c );
+    if (!forgeplay_file_range_is_valid( nt_offset, 24, file_size ) ||
+        forgeplay_read_dword( bytes, nt_offset ) != IMAGE_NT_SIGNATURE)
+        goto done;
+    section_count = forgeplay_read_word( bytes, nt_offset + 6 );
+    optional_size = forgeplay_read_word( bytes, nt_offset + 20 );
+    optional_offset = nt_offset + 24;
+    if (!section_count || section_count > 96 ||
+        !forgeplay_file_range_is_valid( optional_offset, optional_size, file_size ) ||
+        optional_size < 112)
+        goto done;
+    optional_magic = forgeplay_read_word( bytes, optional_offset );
+    if (optional_magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC)
+    {
+        scan->pe64 = TRUE;
+        directory_offset = optional_offset + 112;
+        directory_count = forgeplay_read_dword( bytes, optional_offset + 108 );
+    }
+    else if (optional_magic == IMAGE_NT_OPTIONAL_HDR32_MAGIC)
+    {
+        scan->pe64 = FALSE;
+        directory_offset = optional_offset + 96;
+        directory_count = forgeplay_read_dword( bytes, optional_offset + 92 );
+    }
+    else goto done;
+    section_offset = optional_offset + optional_size;
+    if (!forgeplay_file_range_is_valid( section_offset,
+                                        (SIZE_T)section_count * IMAGE_SIZEOF_SECTION_HEADER,
+                                        file_size ))
+        goto done;
+    size_of_headers = forgeplay_read_dword( bytes, optional_offset + 60 );
+    scan->valid_pe = TRUE;
+
+    if (directory_count > IMAGE_DIRECTORY_ENTRY_IMPORT &&
+        forgeplay_file_range_is_valid( directory_offset + IMAGE_DIRECTORY_ENTRY_IMPORT * 8,
+                                       8, optional_offset + optional_size ))
+    {
+        import_rva = forgeplay_read_dword( bytes, directory_offset + IMAGE_DIRECTORY_ENTRY_IMPORT * 8 );
+        import_size = forgeplay_read_dword( bytes, directory_offset + IMAGE_DIRECTORY_ENTRY_IMPORT * 8 + 4 );
+        forgeplay_scan_pe_import_directory( bytes, file_size, section_offset, section_count,
+                                            size_of_headers, import_rva, import_size, FALSE, scan );
+    }
+    if (directory_count > IMAGE_DIRECTORY_ENTRY_DELAY_IMPORT &&
+        forgeplay_file_range_is_valid( directory_offset + IMAGE_DIRECTORY_ENTRY_DELAY_IMPORT * 8,
+                                       8, optional_offset + optional_size ))
+    {
+        delay_rva = forgeplay_read_dword( bytes, directory_offset + IMAGE_DIRECTORY_ENTRY_DELAY_IMPORT * 8 );
+        delay_size = forgeplay_read_dword( bytes, directory_offset + IMAGE_DIRECTORY_ENTRY_DELAY_IMPORT * 8 + 4 );
+        forgeplay_scan_pe_import_directory( bytes, file_size, section_offset, section_count,
+                                            size_of_headers, delay_rva, delay_size, TRUE, scan );
+    }
+
+done:
+    if (bytes) UnmapViewOfFile( bytes );
+    if (mapping) CloseHandle( mapping );
+    if (file != INVALID_HANDLE_VALUE) CloseHandle( file );
+    HeapFree( GetProcessHeap(), 0, relative_path );
+}
