+
+static void forgeplay_record_import_generation( struct forgeplay_game_renderer_import_scan *scan,
+                                                const char *module, BOOL delayed )
+{
+    enum forgeplay_direct3d_generation generation = FORGEPLAY_DIRECT3D_NONE;
+    char *destination = NULL;
+    BOOL *delayed_destination = NULL;
+
+    scan->saw_import = TRUE;
+    /* A clear d3d12/dx12 token also covers vendor bridge modules such as
+     * FidelityFX DX12 without relying on a game name or Steam AppID. */
+    if (forgeplay_ascii_contains_case_insensitive( module, "d3d12" ) ||
+        forgeplay_ascii_contains_case_insensitive( module, "dx12" ))
+    {
+        generation = FORGEPLAY_DIRECT3D_12;
+        destination = scan->d3d12_module;
+        delayed_destination = &scan->d3d12_delayed;
+    }
+    else if (forgeplay_ascii_contains_case_insensitive( module, "d3d11" ) ||
+             forgeplay_ascii_contains_case_insensitive( module, "dx11" ))
+    {
+        generation = FORGEPLAY_DIRECT3D_11;
+        destination = scan->d3d11_module;
+        delayed_destination = &scan->d3d11_delayed;
+    }
+    else if (forgeplay_ascii_contains_case_insensitive( module, "d3d10" ) ||
+             forgeplay_ascii_contains_case_insensitive( module, "dx10" ))
+    {
+        generation = FORGEPLAY_DIRECT3D_10;
+        destination = scan->d3d10_module;
+        delayed_destination = &scan->d3d10_delayed;
+    }
+    else if (forgeplay_ascii_contains_case_insensitive( module, "d3d9" ) ||
+             forgeplay_ascii_contains_case_insensitive( module, "dx9" ))
+    {
+        generation = FORGEPLAY_DIRECT3D_9;
+        destination = scan->d3d9_module;
+        delayed_destination = &scan->d3d9_delayed;
+    }
+    else if (forgeplay_ascii_contains_case_insensitive( module, "d3d8" ) ||
+             forgeplay_ascii_contains_case_insensitive( module, "dx8" ))
+    {
+        generation = FORGEPLAY_DIRECT3D_8;
+        destination = scan->d3d8_module;
+        delayed_destination = &scan->d3d8_delayed;
+    }
+    if (generation != FORGEPLAY_DIRECT3D_NONE)
+        scan->generation_mask |= FORGEPLAY_DIRECT3D_BIT(generation);
+    if (destination && !destination[0])
+    {
+        lstrcpynA( destination, module, 128 );
+        *delayed_destination = delayed;
+    }
+}
+
+
+static void forgeplay_scan_pe_import_directory( const BYTE *bytes, SIZE_T file_size,
+                                                SIZE_T section_offset, WORD section_count,
+                                                DWORD size_of_headers, DWORD directory_rva,
+                                                DWORD directory_size, BOOL delayed,
+                                                struct forgeplay_game_renderer_import_scan *scan )
+{
+    SIZE_T directory_offset, descriptor_size = delayed ? 32 : sizeof(IMAGE_IMPORT_DESCRIPTOR);
+    SIZE_T available, count, i;
+
+    if (!directory_rva ||
+        !forgeplay_pe_rva_to_file_offset( bytes, file_size, section_offset, section_count,
+                                          size_of_headers, directory_rva, &directory_offset ))
+        return;
+    available = file_size - directory_offset;
+    if (directory_size && directory_size < available) available = directory_size;
+    count = min( available / descriptor_size, 4096 );
+    for (i = 0; i < count; ++i)
+    {
+        SIZE_T descriptor_offset = directory_offset + i * descriptor_size, name_offset;
+        DWORD name_rva = forgeplay_read_dword( bytes, descriptor_offset + (delayed ? 4 : 12) );
+        char module[128];
+
+        if (!name_rva) break;
+        if (!forgeplay_pe_rva_to_file_offset( bytes, file_size, section_offset, section_count,
+                                              size_of_headers, name_rva, &name_offset ))
+            continue;
+        if (!forgeplay_copy_import_module_name( bytes, file_size, name_offset,
+                                                module, ARRAY_SIZE(module) ))
+            continue;
+        forgeplay_record_import_generation( scan, module, delayed );
+    }
+}
+
