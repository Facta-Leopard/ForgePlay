+/***********************************************************************
+ * record_forgeplay_game_renderer_module_load
+ *
+ * Record the loader's resolved module path separately from the route-time
+ * plan. Only a successful path-owner=verified record proves that a Direct3D
+ * renderer DLL loaded from the active process-scoped renderer allowlist.
+ */
+static void record_forgeplay_game_renderer_module_load( const WCHAR *requested,
+                                                        const WINE_MODREF *module,
+                                                        NTSTATUS load_status )
+{
+    const WCHAR *basename = forgeplay_renderer_module_basename( requested );
+    UNICODE_STRING observation_path = { 0 }, nt_path = { 0 };
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    LARGE_INTEGER offset;
+    HANDLE file;
+    char requested_utf8[256], actual_path[1536], executable[1536];
+    char profile[64], owner[64], correlation[96], record[4096];
+    const char *state = load_status ? "failed" : "loaded";
+    const char *path_owner;
+    int record_size;
+    NTSTATUS status;
+
+    if (!forgeplay_game_renderer_is_active() ||
+        !forgeplay_is_renderer_module( requested )) return;
+    if (!forgeplay_unicode_to_utf8( basename, wcslen(basename),
+                                    requested_utf8, sizeof(requested_utf8) ))
+        strcpy( requested_utf8, "unavailable" );
+    if (load_status || !module ||
+        !forgeplay_unicode_to_utf8( module->ldr.FullDllName.Buffer,
+                                    module->ldr.FullDllName.Length / sizeof(WCHAR),
+                                    actual_path, sizeof(actual_path) ))
+        strcpy( actual_path, "unavailable" );
+    path_owner = load_status ? "unavailable" :
+        forgeplay_renderer_module_path_owner( module, basename );
+    if (!forgeplay_renderer_env_to_utf8( L"FORGEPLAY_GAME_RENDERER_PROFILE",
+                                         profile, sizeof(profile) ))
+        strcpy( profile, "unreported" );
+    if (!forgeplay_renderer_env_to_utf8( L"FORGEPLAY_GAME_RENDERER_APPLIED",
+                                         owner, sizeof(owner) ))
+        strcpy( owner, "unreported" );
+    if (!forgeplay_renderer_env_to_utf8( L"FORGEPLAY_GAME_RENDERER_CORRELATION_ID",
+                                         correlation, sizeof(correlation) ))
+        strcpy( correlation, "unreported" );
+    if (!forgeplay_unicode_to_utf8(
+            NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer,
+            NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Length / sizeof(WCHAR),
+            executable, sizeof(executable) ))
+        strcpy( executable, "unavailable" );
+
+    status = get_env_var( L"FORGEPLAY_PROCESS_OBSERVATION_FILE", 0, &observation_path );
+    if (status) return;
+    if (!RtlDosPathNameToNtPathName_U( observation_path.Buffer, &nt_path, NULL, NULL ))
+        goto done;
+    InitializeObjectAttributes( &attr, &nt_path, OBJ_CASE_INSENSITIVE, 0, NULL );
+    status = NtCreateFile( &file, FILE_APPEND_DATA | SYNCHRONIZE, &attr, &io, NULL,
+                           FILE_ATTRIBUTE_NORMAL,
+                           FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                           FILE_OPEN_IF,
+                           FILE_NON_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT,
+                           NULL, 0 );
+    if (status) goto done_nt_path;
+
+    record_size = snprintf(
+        record, sizeof(record),
+        "FORGEPLAY_GAME_RENDERER_LOAD_V3\t%lu\tstate=%s | module=%s | actual-path=%s | "
+        "path-owner=%s | profile=%s | owner=%s | status=0x%08lx | correlation=%s | executable=%s\n",
+        (unsigned long)HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess ),
+        state, requested_utf8, actual_path, path_owner, profile, owner,
+        (unsigned long)load_status, correlation, executable );
+    if (record_size > 0 && (SIZE_T)record_size < sizeof(record))
+    {
+        offset.QuadPart = -1;
+        if (!NtWriteFile( file, NULL, NULL, NULL, &io, record, record_size, &offset, NULL ))
+            NtFlushBuffersFile( file, &io );
+    }
+    NtClose( file );
+
+done_nt_path:
+    RtlFreeUnicodeString( &nt_path );
+done:
+    RtlFreeHeap( GetProcessHeap(), 0, observation_path.Buffer );
+}
+
+
+/***********************************************************************
+ *	prepend_forgeplay_game_renderer_dll_path
+ *
+ * Native renderer modules live outside the prefix so Steam cannot load them.
+ * A game process marked by kernelbase gets its architecture-specific
+ * renderer directory ahead of the normal DLL search path before imports
+ * for the main executable are resolved.
+ */
+static NTSTATUS prepend_forgeplay_game_renderer_dll_path( WCHAR **load_path )
+{
+#ifdef _WIN64
+    static const WCHAR renderer_path_name[] = L"FORGEPLAY_GAME_RENDERER_DLL_PATH_X64";
+#else
+    static const WCHAR renderer_path_name[] = L"FORGEPLAY_GAME_RENDERER_DLL_PATH_X86";
+#endif
+    UNICODE_STRING active = { 0 }, renderer_path = { 0 };
+    WCHAR *combined;
+    SIZE_T renderer_length, load_path_length, combined_length;
+    NTSTATUS status;
+
+    status = get_env_var( L"FORGEPLAY_GAME_RENDERER_ACTIVE", 0, &active );
+    if (status == STATUS_VARIABLE_NOT_FOUND) return STATUS_SUCCESS;
+    if (status) return status;
+    if (active.Length != sizeof(WCHAR) || active.Buffer[0] != L'1')
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, active.Buffer );
+        return STATUS_SUCCESS;
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, active.Buffer );
+
+    if ((status = get_env_var( renderer_path_name, 0, &renderer_path ))) return status;
+    renderer_length = renderer_path.Length / sizeof(WCHAR);
+    if (!renderer_length)
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, renderer_path.Buffer );
+        return STATUS_INVALID_PARAMETER;
+    }
+    load_path_length = *load_path ? wcslen( *load_path ) : 0;
+    combined_length = renderer_length + (load_path_length ? 1 : 0) + load_path_length + 1;
+    if (!(combined = RtlAllocateHeap( GetProcessHeap(), 0, combined_length * sizeof(WCHAR) )))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, renderer_path.Buffer );
+        return STATUS_NO_MEMORY;
+    }
+    memcpy( combined, renderer_path.Buffer, renderer_length * sizeof(WCHAR) );
+    if (load_path_length)
+    {
+        combined[renderer_length] = L';';
+        memcpy( combined + renderer_length + 1, *load_path,
+                (load_path_length + 1) * sizeof(WCHAR) );
+    }
+    else combined[renderer_length] = 0;
+    RtlFreeHeap( GetProcessHeap(), 0, renderer_path.Buffer );
+    *load_path = combined;
+    TRACE( "applied ForgePlay Steam game renderer DLL search path\n" );
+    return STATUS_SUCCESS;
+}
+
+
