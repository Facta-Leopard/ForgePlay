+static BOOL forgeplay_file_range_is_valid( SIZE_T offset, SIZE_T length, SIZE_T file_size )
+{
+    return offset <= file_size && length <= file_size - offset;
+}
+
+
+static WORD forgeplay_read_word( const BYTE *bytes, SIZE_T offset )
+{
+    WORD value;
+    memcpy( &value, bytes + offset, sizeof(value) );
+    return value;
+}
+
+
+static DWORD forgeplay_read_dword( const BYTE *bytes, SIZE_T offset )
+{
+    DWORD value;
+    memcpy( &value, bytes + offset, sizeof(value) );
+    return value;
+}
+
+
+static BOOL forgeplay_pe_rva_to_file_offset( const BYTE *bytes, SIZE_T file_size,
+                                             SIZE_T section_offset, WORD section_count,
+                                             DWORD size_of_headers, DWORD rva,
+                                             SIZE_T *file_offset )
+{
+    unsigned int i;
+
+    if (rva < size_of_headers && rva < file_size)
+    {
+        *file_offset = rva;
+        return TRUE;
+    }
+    for (i = 0; i < section_count; ++i)
+    {
+        SIZE_T offset = section_offset + i * IMAGE_SIZEOF_SECTION_HEADER;
+        DWORD virtual_size, virtual_address, raw_size, raw_offset, mapped_size, delta;
+
+        if (!forgeplay_file_range_is_valid( offset, IMAGE_SIZEOF_SECTION_HEADER, file_size ))
+            return FALSE;
+        virtual_size = forgeplay_read_dword( bytes, offset + 8 );
+        virtual_address = forgeplay_read_dword( bytes, offset + 12 );
+        raw_size = forgeplay_read_dword( bytes, offset + 16 );
+        raw_offset = forgeplay_read_dword( bytes, offset + 20 );
+        mapped_size = max( virtual_size, raw_size );
+        if (rva < virtual_address || rva - virtual_address >= mapped_size) continue;
+        delta = rva - virtual_address;
+        if (delta >= raw_size || !forgeplay_file_range_is_valid( raw_offset, delta + 1, file_size ))
+            return FALSE;
+        *file_offset = raw_offset + delta;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+
+static BOOL forgeplay_ascii_contains_case_insensitive( const char *text, const char *needle )
+{
+    SIZE_T text_length = strlen( text ), needle_length = strlen( needle ), i, j;
+
+    if (!needle_length || needle_length > text_length) return FALSE;
+    for (i = 0; i <= text_length - needle_length; ++i)
+    {
+        for (j = 0; j < needle_length; ++j)
+        {
+            char left = text[i + j], right = needle[j];
+            if (left >= 'A' && left <= 'Z') left += 'a' - 'A';
+            if (right >= 'A' && right <= 'Z') right += 'a' - 'A';
+            if (left != right) break;
+        }
+        if (j == needle_length) return TRUE;
+    }
+    return FALSE;
+}
+
+
+static BOOL forgeplay_copy_import_module_name( const BYTE *bytes, SIZE_T file_size,
+                                               SIZE_T name_offset, char *name, SIZE_T name_size )
+{
+    const BYTE *terminator;
+    SIZE_T length, i;
+
+    if (!name_size || name_offset >= file_size) return FALSE;
+    terminator = memchr( bytes + name_offset, 0, min( file_size - name_offset, name_size ) );
+    if (!terminator) return FALSE;
+    length = terminator - (bytes + name_offset);
+    if (!length || length >= name_size) return FALSE;
+    for (i = 0; i < length; ++i)
+    {
+        BYTE value = bytes[name_offset + i];
+        if (value < 0x20 || value > 0x7e || value == '|') return FALSE;
+        name[i] = value;
+    }
+    name[length] = 0;
+    return TRUE;
+}
