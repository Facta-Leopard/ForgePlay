+    for (i = 0; i < ARRAY_SIZE(variables); ++i)
+    {
+        if (!set_forgeplay_unix_environment_variable( params->Environment, variables[i] ))
+            return FALSE;
+    }
+    TRACE( "applied ForgePlay Steam game renderer Unix environment\n" );
+    return TRUE;
+}
