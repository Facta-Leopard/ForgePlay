+static BOOL forgeplay_game_renderer_profile_is_available( const WCHAR *profile, BOOL pe64 )
+{
+    WCHAR variable[128], value[2];
+
+    swprintf( variable, ARRAY_SIZE(variable),
+              L"FORGEPLAY_GAME_RENDERER_PROFILE_%s_DLL_PATH_%s",
+              profile, pe64 ? L"X64" : L"X86" );
+    return GetEnvironmentVariableW( variable, value, ARRAY_SIZE(value) ) != 0 ||
+           GetLastError() == ERROR_MORE_DATA;
+}
+
+
+static BOOL forgeplay_try_game_renderer_profile( struct forgeplay_game_renderer_route *route,
+                                                 const WCHAR *applied, const WCHAR *profile,
+                                                 BOOL pe64, BOOL d3dmetal_bridge_required )
+{
+    if (!forgeplay_game_renderer_profile_is_available( profile, pe64 )) return FALSE;
+    route->applied = applied;
+    route->profile = profile;
+    route->d3dmetal_bridge_required = d3dmetal_bridge_required;
+    route->supported = TRUE;
+    return TRUE;
+}
+
+
+static void forgeplay_set_unsupported_renderer_route(
+    struct forgeplay_game_renderer_route *route, const WCHAR *reason )
+{
+    route->applied = L"unsupported";
+    route->profile = NULL;
+    route->reason = reason;
+    route->d3dmetal_bridge_required = FALSE;
+    route->deferred = FALSE;
+    route->supported = FALSE;
+}
+
+
+/* Generation-specific profiles remain independent so a missing legacy
+ * renderer cannot disable a valid D3D11/12 route. A valid PE without static
+ * generation evidence uses an architecture-specific loader-stage profile:
+ * each module name still has exactly one owner, which supports games that
+ * resolve Direct3D through LoadLibrary. A PE whose architecture is unknown
+ * remains on the base Runtime with game lineage. DXVK is never an automatic
+ * catch-all because its D3D9/D3D11 ownership overlaps the dedicated profiles. */
+static void forgeplay_set_deferred_renderer_route(
+    struct forgeplay_game_renderer_route *route, const WCHAR *reason )
+{
+    route->applied = L"deferred";
+    route->profile = NULL;
+    route->reason = reason;
+    route->d3dmetal_bridge_required = FALSE;
+    route->deferred = TRUE;
+    route->supported = FALSE;
+}
+
+
+static void forgeplay_set_renderer_route_evidence( struct forgeplay_game_renderer_route *route,
+                                                   const struct forgeplay_game_renderer_import_scan *scan,
+                                                   enum forgeplay_direct3d_generation generation )
+{
+    const char *module;
+    BOOL delayed;
+    WCHAR moduleW[128], generations[64];
+
+    module = forgeplay_game_renderer_generation_module( scan, generation, &delayed );
+    if (!module || !module[0]) module = "unavailable";
+    if (!MultiByteToWideChar( CP_ACP, 0, module, -1, moduleW, ARRAY_SIZE(moduleW) ))
+        lstrcpyW( moduleW, L"unavailable" );
+    if (forgeplay_game_renderer_generation_count( scan ) > 1)
+    {
+        forgeplay_format_game_renderer_generations( scan, generations,
+                                                     ARRAY_SIZE(generations) );
+        swprintf( route->evidence, ARRAY_SIZE(route->evidence),
+                  L"%s;%s=%s;generation-conflict=%s;selected=%s;"
+                  L"resolution=highest-generation-before-route-commit",
+                  scan->pe64 ? L"pe32+" : L"pe32",
+                  delayed ? L"delay-import" : L"import", moduleW, generations,
+                  forgeplay_direct3d_generation_name( generation ) );
+    }
+    else
+    {
+        swprintf( route->evidence, ARRAY_SIZE(route->evidence), L"%s;%s=%s",
+                  scan->pe64 ? L"pe32+" : L"pe32",
+                  delayed ? L"delay-import" : L"import", moduleW );
+    }
+}
+
+
+static void forgeplay_resolve_game_renderer_route( const WCHAR *filename, const WCHAR *cur_dir,
+                                                   USHORT requested_machine,
+                                                   struct forgeplay_game_renderer_route *route )
+{
+    static const WCHAR automatic[] = L"automatic";
+    static const WCHAR d3dmetal[] = L"d3dMetal";
+    static const WCHAR dxmt[] = L"dxmt";
+    static const WCHAR dxvk[] = L"dxvk";
+    static const WCHAR d9vk[] = L"d9vk";
+    static const WCHAR loader[] = L"loader";
+    static const WCHAR profile_d3dmetal_d3d11[] = L"D3DMETAL_D3D11";
+    static const WCHAR profile_d3dmetal_d3d12[] = L"D3DMETAL_D3D12";
+    static const WCHAR profile_dxmt[] = L"DXMT";
+    static const WCHAR profile_d9vk[] = L"D9VK";
+    static const WCHAR profile_loader_x64[] = L"LOADER_X64";
+    static const WCHAR profile_loader_x86[] = L"LOADER_X86";
+    WCHAR policy[32];
+    const WCHAR *architecture_evidence;
+    DWORD policy_size, saved_error = GetLastError();
+    struct forgeplay_game_renderer_import_scan scan;
+    enum forgeplay_direct3d_generation generation;
+
+    memset( route, 0, sizeof(*route) );
+    forgeplay_scan_game_renderer_imports( filename, cur_dir, &scan );
+    generation = forgeplay_select_game_renderer_generation( &scan );
+    policy_size = GetEnvironmentVariableW( L"FORGEPLAY_GAME_RENDERER_POLICY",
+                                           policy, ARRAY_SIZE(policy) );
+    if (policy_size && policy_size < ARRAY_SIZE(policy) && !wcscmp( policy, L"vulkan" ))
+    {
+        route->requested = L"vulkan";
+        route->applied = dxvk;
+        route->reason = L"explicit-policy";
+        route->supported = TRUE;
+        lstrcpyW( route->evidence, scan.valid_pe ?
+                  (scan.pe64 ? L"host-policy;pe32+" : L"host-policy;pe32") :
+                  L"host-policy;pe-unreadable" );
+        SetLastError( saved_error );
+        return;
+    }
+    if (scan.valid_pe) architecture_evidence = scan.pe64 ? L"pe32+" : L"pe32";
+    else if (requested_machine == IMAGE_FILE_MACHINE_AMD64)
+    {
+        scan.pe64 = TRUE;
+        architecture_evidence = L"machine=amd64;pe-unreadable";
+    }
+    else if (requested_machine == IMAGE_FILE_MACHINE_I386)
+    {
+        scan.pe64 = FALSE;
+        architecture_evidence = L"machine=i386;pe-unreadable";
+    }
+    else
+    {
+        route->requested = policy_size && policy_size < ARRAY_SIZE(policy) &&
+                           !wcscmp( policy, L"d3dMetal" ) ? d3dmetal : automatic;
+        if (route->requested == d3dmetal)
+            forgeplay_set_unsupported_renderer_route(
+                route, L"explicit-metal-pe-unreadable-machine-unknown" );
+        else
+            forgeplay_set_deferred_renderer_route(
+                route, L"automatic-deferred-pe-unreadable-machine-unknown" );
+        lstrcpyW( route->evidence, L"pe-unreadable;machine=unknown" );
+        SetLastError( saved_error );
+        return;
+    }
+
+    if (policy_size && policy_size < ARRAY_SIZE(policy) && !wcscmp( policy, L"d3dMetal" ))
+    {
+        route->requested = d3dmetal;
+        forgeplay_set_unsupported_renderer_route( route, L"explicit-metal-generation-unknown" );
+        if (!scan.valid_pe)
+        {
+            if ((scan.pe64 && forgeplay_try_game_renderer_profile(
+                     route, loader, profile_loader_x64, TRUE, TRUE )) ||
+                (!scan.pe64 && forgeplay_try_game_renderer_profile(
+                     route, loader, profile_loader_x86, FALSE, FALSE )))
+                route->reason = scan.pe64 ?
+                    L"explicit-metal-loader-stage-x64" :
+                    L"explicit-metal-loader-stage-x86";
+            else
+                forgeplay_set_deferred_renderer_route(
+                    route, L"explicit-metal-loader-stage-profile-unavailable" );
+            swprintf( route->evidence, ARRAY_SIZE(route->evidence),
+                      L"host-policy;%s;generation-unreadable", architecture_evidence );
+        }
+        else if (generation == FORGEPLAY_DIRECT3D_12)
+        {
+            if (scan.pe64 && forgeplay_try_game_renderer_profile(
+                    route, d3dmetal, profile_d3dmetal_d3d12, TRUE, TRUE ))
+                route->reason = L"explicit-metal-d3d12";
+            else
+                forgeplay_set_unsupported_renderer_route(
+                    route, scan.pe64 ? L"explicit-metal-d3d12-profile-unavailable" :
+                                       L"explicit-metal-d3d12-unsupported-pe32" );
+            forgeplay_set_renderer_route_evidence( route, &scan, generation );
+        }
+        else if (generation == FORGEPLAY_DIRECT3D_11 ||
+                 generation == FORGEPLAY_DIRECT3D_10)
+        {
+            if ((scan.pe64 && forgeplay_try_game_renderer_profile(
+                     route, d3dmetal, profile_d3dmetal_d3d11, TRUE, TRUE )) ||
+                (!scan.pe64 && forgeplay_try_game_renderer_profile(
+                     route, dxmt, profile_dxmt, FALSE, FALSE )))
+                route->reason = scan.pe64 ? L"explicit-metal-d3d11-family" :
+                                            L"explicit-metal-dxmt-d3d11-family";
+            else
+                forgeplay_set_unsupported_renderer_route(
+                    route, L"explicit-metal-d3d11-profile-unavailable" );
+            forgeplay_set_renderer_route_evidence( route, &scan, generation );
+        }
+        else if (generation == FORGEPLAY_DIRECT3D_9)
+        {
+            if (forgeplay_try_game_renderer_profile(
+                    route, d9vk, profile_d9vk, scan.pe64, FALSE ))
+                route->reason = L"explicit-metal-d3d9";
+            else
+                forgeplay_set_unsupported_renderer_route(
+                    route, L"explicit-metal-d3d9-profile-unavailable" );
+            forgeplay_set_renderer_route_evidence( route, &scan, generation );
+        }
+        else if (generation == FORGEPLAY_DIRECT3D_8)
+        {
+            forgeplay_set_unsupported_renderer_route(
+                route, L"explicit-metal-d3d8-unsupported" );
+            forgeplay_set_renderer_route_evidence( route, &scan, generation );
+        }
+        else
+        {
+            if ((scan.pe64 && forgeplay_try_game_renderer_profile(
+                     route, loader, profile_loader_x64, TRUE, TRUE )) ||
+                (!scan.pe64 && forgeplay_try_game_renderer_profile(
+                     route, loader, profile_loader_x86, FALSE, FALSE )))
+                route->reason = scan.pe64 ?
+                    L"explicit-metal-loader-stage-x64" :
+                    L"explicit-metal-loader-stage-x86";
+            else
+                forgeplay_set_deferred_renderer_route(
+                    route, L"explicit-metal-loader-stage-profile-unavailable" );
+            swprintf( route->evidence, ARRAY_SIZE(route->evidence), L"host-policy;%s;%s",
+                      architecture_evidence,
+                      scan.saw_import ? L"no-direct3d-generation" : L"empty-import-table" );
+        }
+        SetLastError( saved_error );
+        return;
+    }
+    route->requested = automatic;
+    forgeplay_set_unsupported_renderer_route( route, L"automatic-no-compatible-profile" );
+    if (!scan.valid_pe)
+    {
+        if ((scan.pe64 && forgeplay_try_game_renderer_profile(
+                 route, loader, profile_loader_x64, TRUE, TRUE )) ||
+            (!scan.pe64 && forgeplay_try_game_renderer_profile(
+                 route, loader, profile_loader_x86, FALSE, FALSE )))
+            route->reason = scan.pe64 ?
+                L"automatic-loader-stage-x64" :
+                L"automatic-loader-stage-x86";
+        else
+            forgeplay_set_deferred_renderer_route(
+                route, L"automatic-loader-stage-profile-unavailable" );
+        swprintf( route->evidence, ARRAY_SIZE(route->evidence), L"%s;generation-unreadable",
+                  architecture_evidence );
+        goto done;
+    }
+    if (generation == FORGEPLAY_DIRECT3D_12)
+    {
+        if (scan.pe64 && forgeplay_try_game_renderer_profile(
+                route, d3dmetal, profile_d3dmetal_d3d12, TRUE, TRUE ))
+            route->reason = L"automatic-d3d12";
+        else
+            forgeplay_set_unsupported_renderer_route(
+                route, scan.pe64 ? L"automatic-d3d12-profile-unavailable" :
+                                   L"automatic-d3d12-unsupported-pe32" );
+        forgeplay_set_renderer_route_evidence( route, &scan, generation );
+    }
+    else if (generation == FORGEPLAY_DIRECT3D_11 ||
+             generation == FORGEPLAY_DIRECT3D_10)
+    {
+        if ((scan.pe64 && forgeplay_try_game_renderer_profile(
+                 route, d3dmetal, profile_d3dmetal_d3d11, TRUE, TRUE )) ||
+            (!scan.pe64 && forgeplay_try_game_renderer_profile(
+                 route, dxmt, profile_dxmt, FALSE, FALSE )))
+            route->reason = scan.pe64 ? L"automatic-d3d11-metal" :
+                                        L"automatic-d3d11-dxmt";
+        else
+            forgeplay_set_unsupported_renderer_route(
+                route, L"automatic-d3d11-profile-unavailable" );
+        forgeplay_set_renderer_route_evidence( route, &scan, generation );
+    }
+    else if (generation == FORGEPLAY_DIRECT3D_9 &&
+             forgeplay_try_game_renderer_profile(
+                 route, d9vk, profile_d9vk, scan.pe64, FALSE ))
+    {
+        route->reason = L"automatic-d3d9-d9vk";
+        forgeplay_set_renderer_route_evidence( route, &scan, generation );
+    }
+    else if (generation == FORGEPLAY_DIRECT3D_8)
+    {
+        forgeplay_set_unsupported_renderer_route(
+            route, L"automatic-d3d8-no-safe-profile" );
+        forgeplay_set_renderer_route_evidence( route, &scan, generation );
+    }
+    else
+    {
+        if (generation == FORGEPLAY_DIRECT3D_9)
+            forgeplay_set_unsupported_renderer_route(
+                route, L"automatic-d3d9-profile-unavailable" );
+        else if ((scan.pe64 && forgeplay_try_game_renderer_profile(
+                      route, loader, profile_loader_x64, TRUE, TRUE )) ||
+                 (!scan.pe64 && forgeplay_try_game_renderer_profile(
+                      route, loader, profile_loader_x86, FALSE, FALSE )))
+            route->reason = scan.pe64 ?
+                L"automatic-loader-stage-x64" :
+                L"automatic-loader-stage-x86";
+        else
+            forgeplay_set_deferred_renderer_route(
+                route, L"automatic-loader-stage-profile-unavailable" );
+        swprintf( route->evidence, ARRAY_SIZE(route->evidence), L"%s;%s",
+                  architecture_evidence,
+                  scan.saw_import ? L"no-direct3d-generation" : L"empty-import-table" );
+    }
+
+done:
+    SetLastError( saved_error );
+}
+
+
+static NTSTATUS clone_forgeplay_process_environment( const void *environment, DWORD flags, WCHAR **result )
+{
+    const WCHAR *unicode_end, *unicode_source;
+    const char *ansi_end, *ansi_source;
+    SIZE_T size;
+    int unicode_size;
+
+    *result = NULL;
+    if (!environment) return RtlCreateEnvironment( TRUE, result );
+
+    if (flags & CREATE_UNICODE_ENVIRONMENT)
+    {
+        unicode_source = environment;
+        unicode_end = unicode_source;
+        while (*unicode_end) unicode_end += wcslen( unicode_end ) + 1;
+        unicode_end++;
+        size = (unicode_end - unicode_source) * sizeof(WCHAR);
+        if (!(*result = RtlAllocateHeap( GetProcessHeap(), 0, size ))) return STATUS_NO_MEMORY;
+        memcpy( *result, unicode_source, size );
+        return STATUS_SUCCESS;
+    }
+
+    ansi_source = environment;
+    ansi_end = ansi_source;
+    while (*ansi_end) ansi_end += strlen( ansi_end ) + 1;
+    ansi_end++;
+    unicode_size = MultiByteToWideChar( CP_ACP, 0, ansi_source, ansi_end - ansi_source, NULL, 0 );
+    if (!unicode_size) return STATUS_INVALID_PARAMETER;
+    if (!(*result = RtlAllocateHeap( GetProcessHeap(), 0, unicode_size * sizeof(WCHAR) )))
+        return STATUS_NO_MEMORY;
+    if (!MultiByteToWideChar( CP_ACP, 0, ansi_source, ansi_end - ansi_source,
+                              *result, unicode_size ))
+    {
+        RtlDestroyEnvironment( *result );
+        *result = NULL;
+        return STATUS_INVALID_PARAMETER;
+    }
+    return STATUS_SUCCESS;
+}
+
+
+static void record_forgeplay_renderer_environment_failure( const WCHAR *operation,
+                                                            const WCHAR *source_name,
+                                                            const WCHAR *target_name,
+                                                            NTSTATUS status )
+{
+    static const WCHAR unreported[] = L"unreported";
+    WCHAR *text;
+    SIZE_T text_size;
+
+    if (!operation) operation = unreported;
+    if (!source_name) source_name = unreported;
+    if (!target_name) target_name = unreported;
+    text_size = wcslen( operation ) + wcslen( source_name ) + wcslen( target_name ) + 80;
+    if (!(text = HeapAlloc( GetProcessHeap(), 0, text_size * sizeof(WCHAR) ))) return;
+    swprintf( text, text_size,
+              L"operation=%s | source=%s | target=%s | status=0x%08lx",
+              operation, source_name, target_name, status );
+    record_process_observation( "FORGEPLAY_GAME_RENDERER_ENVIRONMENT_V1\t", text,
+                                GetCurrentProcessId() );
+    HeapFree( GetProcessHeap(), 0, text );
+}
+
+
+static NTSTATUS set_forgeplay_renderer_environment_variable( WCHAR **environment,
+                                                             const WCHAR *source_name,
+                                                             const WCHAR *target_name )
+{
+    static const WCHAR unset_value[] = L"__FORGEPLAY_UNSET__";
+    UNICODE_STRING name, value_string, *value = &value_string;
+    WCHAR *buffer;
+    BOOL removing;
+    DWORD size;
+    NTSTATUS status;
+
+    size = GetEnvironmentVariableW( source_name, NULL, 0 );
+    if (!size || size > 32767)
+    {
+        status = STATUS_INVALID_PARAMETER;
+        record_forgeplay_renderer_environment_failure(
+            L"read-source", source_name, target_name, status );
+        return status;
+    }
+    if (!(buffer = RtlAllocateHeap( GetProcessHeap(), 0, size * sizeof(WCHAR) )))
+    {
+        status = STATUS_NO_MEMORY;
+        record_forgeplay_renderer_environment_failure(
+            L"read-source", source_name, target_name, status );
+        return status;
+    }
+    if (!GetEnvironmentVariableW( source_name, buffer, size ))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, buffer );
+        status = STATUS_INVALID_PARAMETER;
+        record_forgeplay_renderer_environment_failure(
+            L"read-source", source_name, target_name, status );
+        return status;
+    }
+
+    RtlInitUnicodeString( &name, target_name );
+    removing = !wcscmp( buffer, unset_value );
+    if (removing) value = NULL;
+    else RtlInitUnicodeString( value, buffer );
+    status = RtlSetEnvironmentVariable( environment, &name, value );
+    if (removing && status == STATUS_VARIABLE_NOT_FOUND) status = STATUS_SUCCESS;
+    if (status)
+        record_forgeplay_renderer_environment_failure(
+            removing ? L"remove-from-source" : L"set-from-source",
+            source_name, target_name, status );
+    RtlFreeHeap( GetProcessHeap(), 0, buffer );
+    return status;
+}
+
+
+static NTSTATUS copy_forgeplay_renderer_variable( WCHAR **environment,
+                                                  const WCHAR *source_name,
+                                                  const WCHAR *target_name,
+                                                  BOOL required )
+{
+    UNICODE_STRING name_string, value;
+    WCHAR *buffer;
+    DWORD size;
+    NTSTATUS status;
+
+    size = GetEnvironmentVariableW( source_name, NULL, 0 );
+    if (!size)
+    {
+        if (required)
+        {
+            status = STATUS_VARIABLE_NOT_FOUND;
+            record_forgeplay_renderer_environment_failure(
+                L"copy-required-source", source_name, target_name, status );
+            return status;
+        }
+        RtlInitUnicodeString( &name_string, target_name );
+        status = RtlSetEnvironmentVariable( environment, &name_string, NULL );
+        if (status == STATUS_VARIABLE_NOT_FOUND) status = STATUS_SUCCESS;
+        if (status)
+            record_forgeplay_renderer_environment_failure(
+                L"remove-optional-target", source_name, target_name, status );
+        return status;
+    }
+    if (size > 32767)
+    {
+        status = STATUS_INVALID_PARAMETER;
+        record_forgeplay_renderer_environment_failure(
+            L"copy-source", source_name, target_name, status );
+        return status;
+    }
+    if (!(buffer = RtlAllocateHeap( GetProcessHeap(), 0, size * sizeof(WCHAR) )))
+    {
+        status = STATUS_NO_MEMORY;
+        record_forgeplay_renderer_environment_failure(
+            L"copy-source", source_name, target_name, status );
+        return status;
+    }
+    if (!GetEnvironmentVariableW( source_name, buffer, size ))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, buffer );
+        status = required ? STATUS_VARIABLE_NOT_FOUND : STATUS_SUCCESS;
+        if (status)
+            record_forgeplay_renderer_environment_failure(
+                L"copy-source", source_name, target_name, status );
+        return status;
+    }
+
+    RtlInitUnicodeString( &name_string, target_name );
+    RtlInitUnicodeString( &value, buffer );
+    status = RtlSetEnvironmentVariable( environment, &name_string, &value );
+    if (status)
+        record_forgeplay_renderer_environment_failure(
+            L"copy-source", source_name, target_name, status );
+    RtlFreeHeap( GetProcessHeap(), 0, buffer );
+    return status;
+}
+
+
+static NTSTATUS set_forgeplay_renderer_literal( WCHAR **environment, const WCHAR *name,
+                                                const WCHAR *literal )
+{
+    UNICODE_STRING name_string, value;
+    NTSTATUS status;
+
+    RtlInitUnicodeString( &name_string, name );
+    RtlInitUnicodeString( &value, literal );
+    status = RtlSetEnvironmentVariable( environment, &name_string, &value );
+    if (status)
+        record_forgeplay_renderer_environment_failure(
+            L"set-literal", L"literal", name, status );
+    return status;
+}
+
+
+static NTSTATUS remove_forgeplay_renderer_variable( WCHAR **environment, const WCHAR *name )
+{
+    UNICODE_STRING name_string;
+    NTSTATUS status;
+
+    RtlInitUnicodeString( &name_string, name );
+    status = RtlSetEnvironmentVariable( environment, &name_string, NULL );
+    if (status == STATUS_VARIABLE_NOT_FOUND) status = STATUS_SUCCESS;
+    if (status)
+        record_forgeplay_renderer_environment_failure(
+            L"remove", L"child-environment", name, status );
+    return status;
+}
