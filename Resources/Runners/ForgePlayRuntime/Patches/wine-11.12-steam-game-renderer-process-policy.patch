+/***********************************************************************
+ *	record_forgeplay_game_renderer_loader_error
+ *
+ * The child loader runs before kernelbase is available, so append a small
+ * ntdll-native record to the same per-launch observation file before a
+ * missing or invalid renderer DLL path terminates the process.
+ */
+static void record_forgeplay_game_renderer_loader_error( NTSTATUS renderer_status )
+{
+#ifdef _WIN64
+    static const char renderer_path_name[] = "FORGEPLAY_GAME_RENDERER_DLL_PATH_X64";
+#else
+    static const char renderer_path_name[] = "FORGEPLAY_GAME_RENDERER_DLL_PATH_X86";
+#endif
+    UNICODE_STRING observation_path = { 0 }, nt_path = { 0 };
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    LARGE_INTEGER offset;
+    HANDLE file;
+    char record[256];
+    int record_size;
+    NTSTATUS status;
+
+    status = get_env_var( L"FORGEPLAY_PROCESS_OBSERVATION_FILE", 0, &observation_path );
+    if (status) return;
+    if (!RtlDosPathNameToNtPathName_U( observation_path.Buffer, &nt_path, NULL, NULL ))
+        goto done;
+
+    InitializeObjectAttributes( &attr, &nt_path, OBJ_CASE_INSENSITIVE, 0, NULL );
+    status = NtCreateFile( &file, FILE_APPEND_DATA | SYNCHRONIZE, &attr, &io, NULL,
+                           FILE_ATTRIBUTE_NORMAL,
+                           FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                           FILE_OPEN_IF,
+                           FILE_NON_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT,
+                           NULL, 0 );
+    if (status) goto done_nt_path;
+
+    record_size = snprintf(
+        record, sizeof(record),
+        "FORGEPLAY_GAME_RENDERER_ERROR_V1\t%lu\tloader-dll-path | status=0x%08lx | %s\n",
+        (unsigned long)HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess ),
+        (unsigned long)renderer_status, renderer_path_name );
+    if (record_size > 0 && (SIZE_T)record_size < sizeof(record))
+    {
+        offset.QuadPart = -1;
+        if (!NtWriteFile( file, NULL, NULL, NULL, &io, record, record_size, &offset, NULL ))
+            NtFlushBuffersFile( file, &io );
+    }
+    NtClose( file );
+
+done_nt_path:
+    RtlFreeUnicodeString( &nt_path );
+done:
+    RtlFreeHeap( GetProcessHeap(), 0, observation_path.Buffer );
+}
+
+
+static BOOL forgeplay_game_renderer_is_active(void)
+{
+    UNICODE_STRING active = { 0 };
+    BOOL result;
+
+    if (get_env_var( L"FORGEPLAY_GAME_RENDERER_ACTIVE", 0, &active )) return FALSE;
+    result = active.Length == sizeof(WCHAR) && active.Buffer[0] == L'1';
+    RtlFreeHeap( GetProcessHeap(), 0, active.Buffer );
+    return result;
+}
+
+
+static const WCHAR *forgeplay_renderer_module_basename( const WCHAR *name )
+{
+    const WCHAR *cursor, *basename = name;
+
+    if (!name) return NULL;
+    for (cursor = name; *cursor; ++cursor)
+        if (*cursor == L'\\' || *cursor == L'/') basename = cursor + 1;
+    return basename;
+}
+
+
+static BOOL forgeplay_is_renderer_module( const WCHAR *name )
+{
+    static const WCHAR *renderer_modules[] =
+    {
+        L"d3d8.dll", L"d3d9.dll", L"d3d10.dll", L"d3d10_1.dll",
+        L"d3d10core.dll", L"d3d11.dll", L"d3d12.dll", L"d3d12core.dll",
+        L"dxgi.dll", L"winemetal.dll", L"nvapi64.dll", L"nvngx.dll",
+        L"nvngx-on-metalfx.dll",
+    };
+    const WCHAR *basename = forgeplay_renderer_module_basename( name );
+    unsigned int i;
+
+    if (!basename || !*basename) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(renderer_modules); ++i)
+        if (!wcsicmp( basename, renderer_modules[i] )) return TRUE;
+    return FALSE;
+}
+
+
+static void forgeplay_sanitize_observation_field( char *text )
+{
+    unsigned char *cursor = (unsigned char *)text;
+
+    while (*cursor)
+    {
+        if (*cursor < 0x20 || *cursor == '|') *cursor = '_';
+        ++cursor;
+    }
+}
+
+
+static BOOL forgeplay_unicode_to_utf8( const WCHAR *text, SIZE_T length,
+                                       char *buffer, DWORD buffer_size )
+{
+    DWORD converted = 0;
+    NTSTATUS status;
+
+    if (!text || !length || buffer_size < 2) return FALSE;
+    status = RtlUnicodeToUTF8N( buffer, buffer_size - 1, &converted,
+                                text, length * sizeof(WCHAR) );
+    if (status || converted >= buffer_size) return FALSE;
+    buffer[converted] = 0;
+    forgeplay_sanitize_observation_field( buffer );
+    return TRUE;
+}
+
+
+static BOOL forgeplay_renderer_env_to_utf8( const WCHAR *name, char *buffer, DWORD buffer_size )
+{
+    UNICODE_STRING value = { 0 };
+    BOOL result = FALSE;
+
+    if (!get_env_var( name, 0, &value ))
+    {
+        result = forgeplay_unicode_to_utf8( value.Buffer, value.Length / sizeof(WCHAR),
+                                            buffer, buffer_size );
+        RtlFreeHeap( GetProcessHeap(), 0, value.Buffer );
+    }
+    return result;
+}
+
+
+static BOOL forgeplay_renderer_path_separator( WCHAR character )
+{
+    return character == L'\\' || character == L'/';
+}
+
+
+static BOOL forgeplay_renderer_path_character_equal( WCHAR left, WCHAR right )
+{
+    if (forgeplay_renderer_path_separator( left ) &&
+        forgeplay_renderer_path_separator( right )) return TRUE;
+    return RtlUpcaseUnicodeChar( left ) == RtlUpcaseUnicodeChar( right );
+}
+
+
+static void forgeplay_renderer_strip_device_prefix( const WCHAR **path, SIZE_T *length )
+{
+    if (*length < 4 || (*path)[0] != L'\\' || (*path)[3] != L'\\') return;
+    if (((*path)[1] == L'?' && (*path)[2] == L'?') ||
+        ((*path)[1] == L'\\' && (*path)[2] == L'?'))
+    {
+        *path += 4;
+        *length -= 4;
+    }
+}
+
+
+/* Match one loader-resolved DLL path to one exact architecture-specific
+ * renderer directory. Device prefixes and separator styles may differ, but
+ * a subdirectory, sibling prefix, or suffix after the requested basename is
+ * never accepted as renderer ownership evidence. */
+static BOOL forgeplay_renderer_path_matches_directory( const WCHAR *actual,
+                                                        SIZE_T actual_length,
+                                                        const WCHAR *directory,
+                                                        SIZE_T directory_length,
+                                                        const WCHAR *basename )
+{
+    SIZE_T basename_length, i;
+
+    forgeplay_renderer_strip_device_prefix( &actual, &actual_length );
+    while (directory_length && (directory[0] == L' ' || directory[0] == L'\t'))
+    {
+        ++directory;
+        --directory_length;
+    }
+    while (directory_length &&
+           (directory[directory_length - 1] == L' ' ||
+            directory[directory_length - 1] == L'\t')) --directory_length;
+    forgeplay_renderer_strip_device_prefix( &directory, &directory_length );
+    while (directory_length &&
+           forgeplay_renderer_path_separator( directory[directory_length - 1] ))
+        --directory_length;
+    if (!directory_length || !basename || !(basename_length = wcslen( basename ))) return FALSE;
+    if (actual_length != directory_length + 1 + basename_length) return FALSE;
+    for (i = 0; i < directory_length; ++i)
+        if (!forgeplay_renderer_path_character_equal( actual[i], directory[i] )) return FALSE;
+    if (!forgeplay_renderer_path_separator( actual[directory_length] )) return FALSE;
+    for (i = 0; i < basename_length; ++i)
+        if (!forgeplay_renderer_path_character_equal(
+                actual[directory_length + 1 + i], basename[i] )) return FALSE;
+    return TRUE;
+}
+
+
+static const char *forgeplay_renderer_module_path_owner( const WINE_MODREF *module,
+                                                         const WCHAR *basename )
+{
+#ifdef _WIN64
+    static const WCHAR renderer_path_name[] = L"FORGEPLAY_GAME_RENDERER_DLL_PATH_X64";
+#else
+    static const WCHAR renderer_path_name[] = L"FORGEPLAY_GAME_RENDERER_DLL_PATH_X86";
+#endif
+    const WCHAR *cursor, *end, *entry;
+    UNICODE_STRING allowed_paths = { 0 };
+    SIZE_T actual_length, entry_length;
+    BOOL saw_directory = FALSE, verified = FALSE;
+
+    if (!module || !module->ldr.FullDllName.Buffer || !module->ldr.FullDllName.Length)
+        return "unavailable";
+    if (get_env_var( renderer_path_name, 0, &allowed_paths )) return "unavailable";
+    actual_length = module->ldr.FullDllName.Length / sizeof(WCHAR);
+    cursor = allowed_paths.Buffer;
+    end = cursor + allowed_paths.Length / sizeof(WCHAR);
+    while (cursor <= end)
+    {
+        entry = cursor;
+        while (cursor < end && *cursor != L';') ++cursor;
+        entry_length = cursor - entry;
+        if (entry_length)
+        {
+            saw_directory = TRUE;
+            if (forgeplay_renderer_path_matches_directory(
+                    module->ldr.FullDllName.Buffer, actual_length,
+                    entry, entry_length, basename ))
+            {
+                verified = TRUE;
+                break;
+            }
+        }
+        if (cursor == end) break;
+        ++cursor;
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, allowed_paths.Buffer );
+    if (!saw_directory) return "unavailable";
+    return verified ? "verified" : "mismatch";
+}
+
