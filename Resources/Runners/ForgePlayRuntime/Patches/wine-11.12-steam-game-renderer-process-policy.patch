+/* Both the regular and delayed import directories have been consumed before
+ * this selector runs. Commit one renderer route only after that complete scan,
+ * so an earlier D3D11 import cannot hide a later D3D12 import. */
+static enum forgeplay_direct3d_generation forgeplay_select_game_renderer_generation(
+    const struct forgeplay_game_renderer_import_scan *scan )
+{
+    int generation;
+
+    for (generation = FORGEPLAY_DIRECT3D_12;
+         generation > FORGEPLAY_DIRECT3D_NONE; --generation)
+    {
+        if (scan->generation_mask & FORGEPLAY_DIRECT3D_BIT(generation))
+            return (enum forgeplay_direct3d_generation)generation;
+    }
+    return FORGEPLAY_DIRECT3D_NONE;
+}
+
+
+static const WCHAR *forgeplay_direct3d_generation_name(
+    enum forgeplay_direct3d_generation generation )
+{
+    switch (generation)
+    {
+    case FORGEPLAY_DIRECT3D_12: return L"d3d12";
+    case FORGEPLAY_DIRECT3D_11: return L"d3d11";
+    case FORGEPLAY_DIRECT3D_10: return L"d3d10";
+    case FORGEPLAY_DIRECT3D_9: return L"d3d9";
+    case FORGEPLAY_DIRECT3D_8: return L"d3d8";
+    default: return L"none";
+    }
+}
+
+
+static const char *forgeplay_game_renderer_generation_module(
+    const struct forgeplay_game_renderer_import_scan *scan,
+    enum forgeplay_direct3d_generation generation, BOOL *delayed )
+{
+    *delayed = FALSE;
+    switch (generation)
+    {
+    case FORGEPLAY_DIRECT3D_12:
+        *delayed = scan->d3d12_delayed;
+        return scan->d3d12_module;
+    case FORGEPLAY_DIRECT3D_11:
+        *delayed = scan->d3d11_delayed;
+        return scan->d3d11_module;
+    case FORGEPLAY_DIRECT3D_10:
+        *delayed = scan->d3d10_delayed;
+        return scan->d3d10_module;
+    case FORGEPLAY_DIRECT3D_9:
+        *delayed = scan->d3d9_delayed;
+        return scan->d3d9_module;
+    case FORGEPLAY_DIRECT3D_8:
+        *delayed = scan->d3d8_delayed;
+        return scan->d3d8_module;
+    default:
+        return NULL;
+    }
+}
+
+
+static unsigned int forgeplay_game_renderer_generation_count(
+    const struct forgeplay_game_renderer_import_scan *scan )
+{
+    unsigned int count = 0, generation;
+
+    for (generation = FORGEPLAY_DIRECT3D_8;
+         generation <= FORGEPLAY_DIRECT3D_12; ++generation)
+    {
+        if (scan->generation_mask & FORGEPLAY_DIRECT3D_BIT(generation)) ++count;
+    }
+    return count;
+}
+
+
+static void forgeplay_format_game_renderer_generations(
+    const struct forgeplay_game_renderer_import_scan *scan, WCHAR *buffer, SIZE_T size )
+{
+    static const enum forgeplay_direct3d_generation priority[] =
+    {
+        FORGEPLAY_DIRECT3D_12,
+        FORGEPLAY_DIRECT3D_11,
+        FORGEPLAY_DIRECT3D_10,
+        FORGEPLAY_DIRECT3D_9,
+        FORGEPLAY_DIRECT3D_8,
+    };
+    SIZE_T length = 0;
+    unsigned int i;
+
+    if (!size) return;
+    buffer[0] = 0;
+    for (i = 0; i < ARRAY_SIZE(priority); ++i)
+    {
+        const WCHAR *name;
+        int written;
+
+        if (!(scan->generation_mask & FORGEPLAY_DIRECT3D_BIT(priority[i]))) continue;
+        name = forgeplay_direct3d_generation_name( priority[i] );
+        written = swprintf( buffer + length, size - length, L"%s%s",
+                            length ? L"," : L"", name );
+        if (written < 0 || (SIZE_T)written >= size - length)
+        {
+            buffer[size - 1] = 0;
+            return;
+        }
+        length += written;
+    }
+}
