+static NTSTATUS create_forgeplay_base_renderer_environment( const void *environment, DWORD flags,
+                                                            WCHAR **result )
+{
+    static const struct
+    {
+        const WCHAR *source_name;
+        const WCHAR *target_name;
+    } base_variables[] =
+    {
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_WINEDLLOVERRIDES", L"WINEDLLOVERRIDES" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_WINEDLLPATH", L"WINEDLLPATH" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_DYLD_LIBRARY_PATH", L"DYLD_LIBRARY_PATH" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_DYLD_FALLBACK_LIBRARY_PATH", L"DYLD_FALLBACK_LIBRARY_PATH" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_DYLD_FRAMEWORK_PATH", L"DYLD_FRAMEWORK_PATH" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_D3DMETAL_FRAMEWORK_PATH", L"D3DMETAL_FRAMEWORK_PATH" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_D3DMETAL_SHARED_LIBRARY", L"FORGEPLAY_D3DMETAL_SHARED_LIBRARY" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_D3DM_WINE_UNIX_CALL", L"D3DM_WINE_UNIX_CALL" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_D3DM_ENABLE_METALFX", L"D3DM_ENABLE_METALFX" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_D3DM_NVNGX_PATH", L"D3DM_NVNGX_PATH" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_VK_ICD_FILENAMES", L"VK_ICD_FILENAMES" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_VK_DRIVER_FILES", L"VK_DRIVER_FILES" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_DXVK_LOG_PATH", L"DXVK_LOG_PATH" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_DXVK_LOG_LEVEL", L"DXVK_LOG_LEVEL" },
+        { L"FORGEPLAY_GAME_RENDERER_BASE_ENV_DXVK_CONFIG", L"DXVK_CONFIG" },
+    };
+    static const WCHAR *renderer_state_variables[] =
+    {
+        L"FORGEPLAY_GAME_RENDERER_ACTIVE",
+        L"FORGEPLAY_GAME_RENDERER_LINEAGE",
+        L"FORGEPLAY_GAME_RENDERER_APPLIED",
+        L"FORGEPLAY_GAME_RENDERER_PROFILE",
+        L"FORGEPLAY_GAME_RENDERER_D3DMETAL_BRIDGE_REQUIRED",
+        L"FORGEPLAY_D3DMETAL_NATIVE_THREAD_CONTEXT",
+        L"FORGEPLAY_GAME_RENDERER_ROUTE_REASON",
+        L"FORGEPLAY_GAME_RENDERER_ROUTE_EVIDENCE",
+        L"FORGEPLAY_GAME_RENDERER_COMPONENTS_X64",
+        L"FORGEPLAY_GAME_RENDERER_COMPONENTS_X86",
+        L"FORGEPLAY_GAME_RENDERER_DLL_PATH_X64",
+        L"FORGEPLAY_GAME_RENDERER_DLL_PATH_X86",
+        L"FORGEPLAY_D3DMETAL_BRIDGE",
+        L"FORGEPLAY_D3DMETAL_TARGET",
+        L"D3DMETAL_SHARED_LIBRARY",
+    };
+    NTSTATUS status;
+    unsigned int i;
+
+    if ((status = clone_forgeplay_process_environment( environment, flags, result ))) return status;
+    for (i = 0; i < ARRAY_SIZE(renderer_state_variables); ++i)
+        if ((status = remove_forgeplay_renderer_variable(
+                 result, renderer_state_variables[i] ))) goto failed;
+    for (i = 0; i < ARRAY_SIZE(base_variables); ++i)
+    {
+        if (!GetEnvironmentVariableW( base_variables[i].source_name, NULL, 0 ))
+            status = remove_forgeplay_renderer_variable( result, base_variables[i].target_name );
+        else
+            status = set_forgeplay_renderer_environment_variable(
+                result, base_variables[i].source_name, base_variables[i].target_name );
+        if (status) goto failed;
+    }
+    return STATUS_SUCCESS;
+
+failed:
+    RtlDestroyEnvironment( *result );
+    *result = NULL;
+    return status;
+}
+
+
+static NTSTATUS create_forgeplay_deferred_renderer_environment(
+    const void *environment, DWORD flags, WCHAR **result )
+{
+    NTSTATUS status;
+
+    if ((status = create_forgeplay_base_renderer_environment(
+             environment, flags, result ))) return status;
+    if ((status = set_forgeplay_renderer_literal(
+             result, L"FORGEPLAY_GAME_RENDERER_LINEAGE", L"1" )))
+    {
+        RtlDestroyEnvironment( *result );
+        *result = NULL;
+    }
+    return status;
+}
+
+
+static NTSTATUS forgeplay_renderer_source_name( const struct forgeplay_game_renderer_route *route,
+                                                const WCHAR *base_name, WCHAR *source_name,
+                                                SIZE_T source_count )
+{
+    static const WCHAR prefix[] = L"FORGEPLAY_GAME_RENDERER_";
+    SIZE_T required;
+
+    if (!route->profile)
+    {
+        required = wcslen( base_name ) + 1;
+        if (required > source_count) return STATUS_BUFFER_TOO_SMALL;
+        memcpy( source_name, base_name, required * sizeof(WCHAR) );
+        return STATUS_SUCCESS;
+    }
+    if (wcsncmp( base_name, prefix, ARRAY_SIZE(prefix) - 1 )) return STATUS_INVALID_PARAMETER;
+    required = wcslen( prefix ) + wcslen( L"PROFILE__" ) + wcslen( route->profile ) +
+               wcslen( base_name + ARRAY_SIZE(prefix) - 1 ) + 1;
+    if (required > source_count) return STATUS_BUFFER_TOO_SMALL;
+    swprintf( source_name, source_count, L"%sPROFILE_%s_%s", prefix, route->profile,
+              base_name + ARRAY_SIZE(prefix) - 1 );
+    return STATUS_SUCCESS;
+}
+
+
+static NTSTATUS create_forgeplay_game_renderer_environment( const void *environment, DWORD flags,
+                                                            const struct forgeplay_game_renderer_route *route,
+                                                            const WCHAR *app_name, WCHAR **result )
+{
+    static const struct
+    {
+        const WCHAR *source_name;
+        const WCHAR *target_name;
+    } variables[] =
+    {
+        { L"FORGEPLAY_GAME_RENDERER_ENV_WINEDLLOVERRIDES", L"WINEDLLOVERRIDES" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_WINEDLLPATH", L"WINEDLLPATH" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_DYLD_LIBRARY_PATH", L"DYLD_LIBRARY_PATH" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_DYLD_FALLBACK_LIBRARY_PATH", L"DYLD_FALLBACK_LIBRARY_PATH" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_DYLD_FRAMEWORK_PATH", L"DYLD_FRAMEWORK_PATH" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_D3DMETAL_FRAMEWORK_PATH", L"D3DMETAL_FRAMEWORK_PATH" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_D3DMETAL_SHARED_LIBRARY", L"FORGEPLAY_D3DMETAL_SHARED_LIBRARY" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_D3DM_WINE_UNIX_CALL", L"D3DM_WINE_UNIX_CALL" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_D3DM_ENABLE_METALFX", L"D3DM_ENABLE_METALFX" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_D3DM_NVNGX_PATH", L"D3DM_NVNGX_PATH" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_VK_ICD_FILENAMES", L"VK_ICD_FILENAMES" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_VK_DRIVER_FILES", L"VK_DRIVER_FILES" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_DXVK_LOG_PATH", L"DXVK_LOG_PATH" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_DXVK_LOG_LEVEL", L"DXVK_LOG_LEVEL" },
+        { L"FORGEPLAY_GAME_RENDERER_ENV_DXVK_CONFIG", L"DXVK_CONFIG" },
+    };
+    static const struct
+    {
+        const WCHAR *name;
+        BOOL required;
+    } selected_control_variables[] =
+    {
+        { L"FORGEPLAY_GAME_RENDERER_COMPONENTS_X64", TRUE },
+        { L"FORGEPLAY_GAME_RENDERER_COMPONENTS_X86", FALSE },
+        { L"FORGEPLAY_GAME_RENDERER_DLL_PATH_X64", TRUE },
+        { L"FORGEPLAY_GAME_RENDERER_DLL_PATH_X86", FALSE },
+    };
+    static const WCHAR *global_control_variables[] =
+    {
+        L"FORGEPLAY_PROCESS_OBSERVATION_FILE",
+        L"FORGEPLAY_GAME_RENDERER_POLICY_ENABLED",
+        L"FORGEPLAY_GAME_RENDERER_POLICY",
+        L"FORGEPLAY_GAME_RENDERER_REQUESTED",
+        L"FORGEPLAY_GAME_RENDERER_ROUTING_MODE",
+        L"FORGEPLAY_GAME_RENDERER_CORRELATION_ID",
+        L"FORGEPLAY_GAME_RENDERER_AVAILABLE_PROFILES",
+        L"FORGEPLAY_GAME_RENDERER_UNAVAILABLE_PROFILES",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_WINEDLLOVERRIDES",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_WINEDLLPATH",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_DYLD_LIBRARY_PATH",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_DYLD_FALLBACK_LIBRARY_PATH",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_DYLD_FRAMEWORK_PATH",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_D3DMETAL_FRAMEWORK_PATH",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_D3DMETAL_SHARED_LIBRARY",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_D3DM_WINE_UNIX_CALL",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_D3DM_ENABLE_METALFX",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_D3DM_NVNGX_PATH",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_VK_ICD_FILENAMES",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_VK_DRIVER_FILES",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_DXVK_LOG_PATH",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_DXVK_LOG_LEVEL",
+        L"FORGEPLAY_GAME_RENDERER_BASE_ENV_DXVK_CONFIG",
+    };
+    static const WCHAR *profiles[] =
+    {
+        L"D3DMETAL_D3D11", L"D3DMETAL_D3D12", L"DXMT", L"D9VK",
+        L"LOADER_X64", L"LOADER_X86"
+    };
+    struct forgeplay_game_renderer_route retained_route = {0};
+    const WCHAR *target_name, *cursor;
+    WCHAR source_name[192], bridge_required_value[2];
+    NTSTATUS status;
+    unsigned int i, j;
+
+    if ((status = clone_forgeplay_process_environment( environment, flags, result ))) return status;
+    /* Selector scope is recomputed for every routed child. Never trust or
+     * propagate a selector inherited from its parent. */
+    if ((status = remove_forgeplay_renderer_variable( result, L"FORGEPLAY_D3DMETAL_BRIDGE" )))
+        goto failed;
+    if ((status = remove_forgeplay_renderer_variable( result, L"FORGEPLAY_D3DMETAL_TARGET" )))
+        goto failed;
+    if ((status = remove_forgeplay_renderer_variable(
+             result, L"FORGEPLAY_D3DMETAL_NATIVE_THREAD_CONTEXT" )))
+        goto failed;
+    for (i = 0; i < ARRAY_SIZE(variables); ++i)
+    {
+        if ((status = forgeplay_renderer_source_name( route, variables[i].source_name,
+                                                      source_name, ARRAY_SIZE(source_name) )))
+            goto failed;
+        status = set_forgeplay_renderer_environment_variable( result, source_name,
+                                                              variables[i].target_name );
+        if (status) goto failed;
+        /* Keep the host-owned source value as well. A Steam launcher can pass
+         * an explicit child environment, and descendants below steamapps/common
+         * must still be able to rehydrate the same renderer policy. */
+        status = copy_forgeplay_renderer_variable( result, source_name,
+                                                   variables[i].source_name, TRUE );
+        if (status) goto failed;
+    }
+    for (i = 0; i < ARRAY_SIZE(selected_control_variables); ++i)
+    {
+        if ((status = forgeplay_renderer_source_name( route, selected_control_variables[i].name,
+                                                      source_name, ARRAY_SIZE(source_name) )))
+            goto failed;
+        status = copy_forgeplay_renderer_variable( result, source_name,
+                                                   selected_control_variables[i].name,
+                                                   selected_control_variables[i].required );
+        if (status) goto failed;
+    }
+    for (i = 0; i < ARRAY_SIZE(global_control_variables); ++i)
+    {
+        status = copy_forgeplay_renderer_variable( result, global_control_variables[i],
+                                                   global_control_variables[i], i < 3 );
+        if (status) goto failed;
+    }
+
+    /* Automatic routing must survive launchers which construct a fresh child
+     * environment. Preserve every named profile, but expose only the selected
+     * profile through the real renderer variables above. */
+    if (route->profile)
+    {
+        for (i = 0; i < ARRAY_SIZE(profiles); ++i)
+        {
+            retained_route.profile = profiles[i];
+            for (j = 0; j < ARRAY_SIZE(variables); ++j)
+            {
+                if ((status = forgeplay_renderer_source_name( &retained_route,
+                                                              variables[j].source_name,
+                                                              source_name,
+                                                              ARRAY_SIZE(source_name) )))
+                    goto failed;
+                if ((status = copy_forgeplay_renderer_variable( result, source_name,
+                                                                source_name, FALSE )))
+                    goto failed;
+            }
+            for (j = 0; j < ARRAY_SIZE(selected_control_variables); ++j)
+            {
+                if ((status = forgeplay_renderer_source_name( &retained_route,
+                                                              selected_control_variables[j].name,
+                                                              source_name,
+                                                              ARRAY_SIZE(source_name) )))
+                    goto failed;
+                if ((status = copy_forgeplay_renderer_variable( result, source_name,
+                                                                source_name, FALSE )))
+                    goto failed;
+            }
+        }
+    }
+
+    bridge_required_value[0] = route->d3dmetal_bridge_required ? L'1' : L'0';
+    bridge_required_value[1] = 0;
+    if ((status = set_forgeplay_renderer_literal( result,
+                                                  L"FORGEPLAY_GAME_RENDERER_ACTIVE", L"1" )))
+        goto failed;
+    if ((status = set_forgeplay_renderer_literal( result,
+                                                  L"FORGEPLAY_GAME_RENDERER_LINEAGE", L"1" )))
+        goto failed;
+    if ((status = set_forgeplay_renderer_literal( result,
+                                                  L"FORGEPLAY_GAME_RENDERER_REQUESTED",
+                                                  route->requested )))
+        goto failed;
+    if ((status = set_forgeplay_renderer_literal( result,
+                                                  L"FORGEPLAY_GAME_RENDERER_APPLIED",
+                                                  route->applied )))
+        goto failed;
+    if ((status = set_forgeplay_renderer_literal( result,
+                                                           L"FORGEPLAY_GAME_RENDERER_PROFILE",
+                                                           route->profile ? route->profile : route->applied )))
+        goto failed;
+    if ((status = set_forgeplay_renderer_literal( result,
+                                                  L"FORGEPLAY_GAME_RENDERER_D3DMETAL_BRIDGE_REQUIRED",
+                                                  bridge_required_value )))
+        goto failed;
+    if ((status = set_forgeplay_renderer_literal( result,
+                                                  L"FORGEPLAY_GAME_RENDERER_ROUTE_REASON",
+                                                  route->reason )))
+        goto failed;
+    if ((status = set_forgeplay_renderer_literal( result,
+                                                  L"FORGEPLAY_GAME_RENDERER_ROUTE_EVIDENCE",
+                                                  route->evidence )))
+        goto failed;
+
+    if (route->d3dmetal_bridge_required)
+    {
+        if (!app_name || !*app_name)
+        {
+            status = STATUS_INVALID_PARAMETER;
+            goto failed;
+        }
+        target_name = app_name;
+        for (cursor = app_name; *cursor; ++cursor)
+            if (*cursor == L'\\' || *cursor == L'/') target_name = cursor + 1;
+        if (!*target_name)
+        {
+            status = STATUS_INVALID_PARAMETER;
+            goto failed;
+        }
+        if ((status = set_forgeplay_renderer_literal( result,
+                                                      L"FORGEPLAY_D3DMETAL_BRIDGE", L"1" )))
+            goto failed;
+        if ((status = set_forgeplay_renderer_literal(
+                 result, L"FORGEPLAY_D3DMETAL_NATIVE_THREAD_CONTEXT", L"1" )))
+            goto failed;
+        if ((status = set_forgeplay_renderer_literal( result,
+                                                      L"FORGEPLAY_D3DMETAL_TARGET", target_name )))
+            goto failed;
+    }
+    return STATUS_SUCCESS;
+
+failed:
+    RtlDestroyEnvironment( *result );
+    *result = NULL;
+    return status;
+}
+
+
+static void record_forgeplay_game_renderer_fallback( const WCHAR *stage, const WCHAR *filename,
+                                                     NTSTATUS status, const WCHAR *result )
+{
+    static const WCHAR unreported[] = L"unreported";
+    WCHAR *text;
+    SIZE_T text_size;
+
+    if (!stage) stage = unreported;
+    if (!filename) filename = L"<unknown>";
+    if (!result) result = unreported;
+    text_size = wcslen( stage ) + wcslen( result ) + wcslen( filename ) + 80;
+    if (!(text = HeapAlloc( GetProcessHeap(), 0, text_size * sizeof(WCHAR) ))) return;
+    swprintf( text, text_size,
+              L"stage=%s | status=0x%08lx | result=%s | path=%s",
+              stage, status, result, filename );
+    record_process_observation( "FORGEPLAY_GAME_RENDERER_FALLBACK_V1\t", text,
+                                GetCurrentProcessId() );
+    HeapFree( GetProcessHeap(), 0, text );
+}
+
+
+static void record_forgeplay_game_renderer_observation(
+    const WCHAR *filename, DWORD process_id,
+    const struct forgeplay_game_renderer_route *route )
+{
+    static const WCHAR unreported[] = L"unreported";
+    WCHAR components_x64[256], components_x86[256], correlation[128];
+    WCHAR components_x64_name[192], components_x86_name[192];
+    const WCHAR *planned_profile = route->profile ? route->profile : route->applied;
+    const WCHAR *reported_owner = route->supported ? route->applied : L"unreported";
+    WCHAR *text;
+    SIZE_T text_size;
+    DWORD x64_size, x86_size, correlation_size;
+
+    if (route->profile)
+    {
+        swprintf( components_x64_name, ARRAY_SIZE(components_x64_name),
+                  L"FORGEPLAY_GAME_RENDERER_PROFILE_%s_COMPONENTS_X64", route->profile );
+        swprintf( components_x86_name, ARRAY_SIZE(components_x86_name),
+                  L"FORGEPLAY_GAME_RENDERER_PROFILE_%s_COMPONENTS_X86", route->profile );
+    }
+    else
+    {
+        lstrcpyW( components_x64_name, L"FORGEPLAY_GAME_RENDERER_COMPONENTS_X64" );
+        lstrcpyW( components_x86_name, L"FORGEPLAY_GAME_RENDERER_COMPONENTS_X86" );
+    }
+    x64_size = GetEnvironmentVariableW( components_x64_name, components_x64,
+                                        ARRAY_SIZE(components_x64) );
+    x86_size = GetEnvironmentVariableW( components_x86_name, components_x86,
+                                        ARRAY_SIZE(components_x86) );
+    if (!x64_size || x64_size >= ARRAY_SIZE(components_x64))
+        lstrcpyW( components_x64, unreported );
+    if (!x86_size || x86_size >= ARRAY_SIZE(components_x86))
+        lstrcpyW( components_x86, unreported );
+    correlation_size = GetEnvironmentVariableW( L"FORGEPLAY_GAME_RENDERER_CORRELATION_ID",
+                                                 correlation, ARRAY_SIZE(correlation) );
+    if (!correlation_size || correlation_size >= ARRAY_SIZE(correlation))
+        lstrcpyW( correlation, unreported );
+
+    if (!filename) filename = L"<unknown>";
+    text_size = wcslen( route->requested ) + wcslen( route->applied ) +
+                wcslen( planned_profile ) + wcslen( components_x64 ) +
+                wcslen( components_x86 ) + wcslen( route->reason ) +
+                wcslen( route->evidence ) + wcslen( correlation ) +
+                wcslen( filename ) + 208;
+    if (!(text = HeapAlloc( GetProcessHeap(), 0, text_size * sizeof(WCHAR) ))) return;
+    swprintf( text, text_size,
+              L"requested=%s | applied=%s | planned-profile=%s | planned-owner=%s | "
+              L"planned-components-x64=%s | planned-components-x86=%s | "
+              L"actual-loaded=unobserved | reason=%s | evidence=%s | correlation=%s | %s",
+              route->requested, reported_owner, planned_profile, reported_owner,
+              components_x64, components_x86, route->reason, route->evidence,
+              correlation, filename );
+    record_process_observation( "FORGEPLAY_GAME_RENDERER_ROUTE_V2\t", text, process_id );
+    HeapFree( GetProcessHeap(), 0, text );
+}
