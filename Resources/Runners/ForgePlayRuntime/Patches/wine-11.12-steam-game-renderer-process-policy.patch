+ * Wine normally inherits the Unix environment of the Steam process when
+ * it execs a Windows child. Mirror only the renderer variables selected by
+ * kernelbase so the child loader, MoltenVK, DXVK, and Metal frameworks see
+ * the game policy without changing the Steam client environment.
+ */
+static const WCHAR *find_forgeplay_process_environment_value( const WCHAR *environment,
+                                                              const WCHAR *name )
+{
+    SIZE_T name_length = wcslen( name );
+
+    while (environment && *environment)
+    {
+        if (!wcsnicmp( environment, name, name_length ) && environment[name_length] == L'=')
+            return environment + name_length + 1;
+        environment += wcslen( environment ) + 1;
+    }
+    return NULL;
+}
+
+
+static const WCHAR *find_forgeplay_process_environment_value_ascii( const WCHAR *environment,
+                                                                    const char *name )
+{
+    WCHAR nameW[64];
+    SIZE_T i, length = strlen( name );
+
+    if (length >= ARRAY_SIZE(nameW)) return NULL;
+    for (i = 0; i <= length; ++i) nameW[i] = name[i];
+    return find_forgeplay_process_environment_value( environment, nameW );
+}
+
+
+static BOOL set_forgeplay_unix_environment_variable( const WCHAR *environment,
+                                                     const char *name )
+{
+    const WCHAR *value = find_forgeplay_process_environment_value_ascii( environment, name );
+    SIZE_T value_length, buffer_size;
+    char *buffer;
+
+    if (!value) return unsetenv( name ) != -1;
+    value_length = wcslen( value );
+    buffer_size = value_length * 3 + 1;
+    if (!(buffer = malloc( buffer_size ))) return FALSE;
+    ntdll_wcstoumbs( value, value_length + 1, buffer, buffer_size, FALSE );
+    if (setenv( name, buffer, 1 ) == -1)
+    {
+        free( buffer );
+        return FALSE;
+    }
+    free( buffer );
+    return TRUE;
+}
+
+
+static BOOL apply_forgeplay_game_renderer_unix_environment(
+    const RTL_USER_PROCESS_PARAMETERS *params )
+{
+    static const char *variables[] =
