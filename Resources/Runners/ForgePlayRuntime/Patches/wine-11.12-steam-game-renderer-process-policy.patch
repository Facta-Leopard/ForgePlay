+        "FORGEPLAY_GAME_RENDERER_LINEAGE",
+        "FORGEPLAY_GAME_RENDERER_POLICY",
+        "FORGEPLAY_GAME_RENDERER_REQUESTED",
+        "FORGEPLAY_GAME_RENDERER_APPLIED",
+        "FORGEPLAY_GAME_RENDERER_PROFILE",
+        "FORGEPLAY_GAME_RENDERER_CORRELATION_ID",
+        "FORGEPLAY_GAME_RENDERER_D3DMETAL_BRIDGE_REQUIRED",
+        "FORGEPLAY_D3DMETAL_NATIVE_THREAD_CONTEXT",
+        "FORGEPLAY_GAME_RENDERER_ROUTE_REASON",
+        "FORGEPLAY_GAME_RENDERER_ROUTE_EVIDENCE",
+        "WINEDLLOVERRIDES",
+        "WINEDLLPATH",
+        "DYLD_LIBRARY_PATH",
+        "DYLD_FALLBACK_LIBRARY_PATH",
+        "DYLD_FRAMEWORK_PATH",
+        "D3DMETAL_FRAMEWORK_PATH",
+        "FORGEPLAY_D3DMETAL_SHARED_LIBRARY",
+        "FORGEPLAY_D3DMETAL_BRIDGE",
+        "FORGEPLAY_D3DMETAL_TARGET",
+        "D3DM_WINE_UNIX_CALL",
+        "VK_ICD_FILENAMES",
+        "VK_DRIVER_FILES",
+        "DXVK_LOG_PATH",
+        "DXVK_LOG_LEVEL",
+        "DXVK_CONFIG",
