--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -1322,6 +1322,26 @@ static BOOL is_dll_native_subsystem( LDR_DATA_TABLE_ENTRY *mod, const IMAGE_NT_H
     return TRUE;
 }
 
+
+static TEB *forgeplay_native_thread_context_base( TEB *teb )
+{
+#if defined(__x86_64__) && !defined(__arm64ec__)
+    return teb->Instrumentation[0];
+#else
+    return NULL;
+#endif
+}
+
+
+static void forgeplay_sync_native_static_tls( TEB *teb )
+{
+    TEB *native_context = forgeplay_native_thread_context_base( teb );
+
+    if (native_context)
+        native_context->ThreadLocalStoragePointer = teb->ThreadLocalStoragePointer;
+}
+
