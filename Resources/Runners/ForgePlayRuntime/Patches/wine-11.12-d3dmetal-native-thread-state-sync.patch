+static struct tm *forgeplay_localtime( const time_t *value, struct tm *result )
+{
+#ifdef __APPLE__
+    return localtime_r( value, result );
+#else
+    struct tm *converted = localtime( value );
+
+    if (!converted) return NULL;
+    *result = *converted;
+    return result;
+#endif
+}
+
+
+static struct tm *forgeplay_gmtime( const time_t *value, struct tm *result )
+{
+#ifdef __APPLE__
+    return gmtime_r( value, result );
+#else
+    struct tm *converted = gmtime( value );
+
+    if (!converted) return NULL;
+    *result = *converted;
+    return result;
+#endif
+}
+
+
+static char *forgeplay_ctime( const time_t *value, char result[26] )
+{
+#ifdef __APPLE__
+    return ctime_r( value, result );
+#else
+    const char *converted = ctime( value );
+
+    if (!converted) return NULL;
+    memcpy( result, converted, 26 );
+    return result;
+#endif
+}
+
+
+static char *forgeplay_asctime( const struct tm *value, char result[26] )
+{
+#ifdef __APPLE__
+    return asctime_r( value, result );
+#else
+    const char *converted = asctime( value );
+
+    if (!converted) return NULL;
+    memcpy( result, converted, 26 );
+    return result;
+#endif
+}
+
