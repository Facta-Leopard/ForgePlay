+/***********************************************************************
+ *           append_process_arguments_from_environment
+ *
+ * Apply one executable-scoped compatibility rule supplied by the host.
+ * The arguments stay outside application-managed files, so an updater
+ * replacing the target executable cannot remove the launch policy.
+ */
+static WCHAR *append_process_arguments_from_environment( const WCHAR *filename, const WCHAR *cmdline )
+{
+    static const WCHAR target_variable[] = L"FORGEPLAY_PROCESS_ARGUMENT_TARGET";
+    static const WCHAR arguments_variable[] = L"FORGEPLAY_PROCESS_ARGUMENT_APPEND";
+    WCHAR target[MAX_PATH], *arguments = NULL, *result = NULL;
+    const WCHAR *basename, *separator;
+    DWORD arguments_size, target_size;
+    SIZE_T result_size;
+
+    target_size = GetEnvironmentVariableW( target_variable, target, ARRAY_SIZE(target) );
+    if (!target_size || target_size >= ARRAY_SIZE(target)) return NULL;
+
+    basename = filename;
+    if ((separator = wcsrchr( basename, L'\\' ))) basename = separator + 1;
+    if ((separator = wcsrchr( basename, L'/' ))) basename = separator + 1;
+    if (wcsicmp( basename, target )) return NULL;
+    if (!process_argument_root_scope_allows( cmdline )) return NULL;
+
+    arguments_size = GetEnvironmentVariableW( arguments_variable, NULL, 0 );
+    if (!arguments_size || arguments_size > 32767) return NULL;
+    if (!(arguments = HeapAlloc( GetProcessHeap(), 0, arguments_size * sizeof(WCHAR) ))) return NULL;
+    if (!GetEnvironmentVariableW( arguments_variable, arguments, arguments_size )) goto done;
+
+    result_size = lstrlenW( cmdline ) + lstrlenW( arguments ) + 2;
+    if (result_size > 32767) goto done;
+    if (!(result = HeapAlloc( GetProcessHeap(), 0, result_size * sizeof(WCHAR) ))) goto done;
+
+    swprintf( result, result_size, L"%s %s", cmdline, arguments );
+    TRACE( "appended host compatibility arguments for %s: %s\n",
+           debugstr_w(filename), debugstr_w(arguments) );
+
+done:
+    HeapFree( GetProcessHeap(), 0, arguments );
+    return result;
+}
+
+
+/***********************************************************************
+ *           process_argument_observation_target_matches
+ *
+ * Select one executable role for host observation without changing its
+ * command line. The host creates a unique observation file per launch.
+ */
+static BOOL process_argument_observation_target_matches( const WCHAR *filename )
+{
+    static const WCHAR target_variable[] = L"FORGEPLAY_PROCESS_OBSERVATION_TARGET";
+    WCHAR target[MAX_PATH];
+    const WCHAR *basename, *separator;
+    DWORD target_size;
+
+    target_size = GetEnvironmentVariableW( target_variable, target, ARRAY_SIZE(target) );
+    if (!target_size || target_size >= ARRAY_SIZE(target)) return FALSE;
+
+    basename = filename;
+    if ((separator = wcsrchr( basename, L'\\' ))) basename = separator + 1;
+    if ((separator = wcsrchr( basename, L'/' ))) basename = separator + 1;
+    return !wcsicmp( basename, target );
+}
+
+
+/***********************************************************************
+ *           record_process_argument_observation
+ *
+ * Record the final command line only for the selected executable role.
+ */
+static void record_process_argument_observation( const WCHAR *cmdline, DWORD process_id )
+{
+    static const WCHAR observation_variable[] = L"FORGEPLAY_PROCESS_OBSERVATION_FILE";
+    static const char record_prefix[] = "FORGEPLAY_PROCESS_V1\t";
+    WCHAR *observation_path = NULL;
+    char process_id_text[16], *record = NULL;
+    DWORD bytes_written, path_size;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    int command_size, process_id_size;
+    SIZE_T i, record_size;
+
+    path_size = GetEnvironmentVariableW( observation_variable, NULL, 0 );
+    if (!path_size || path_size > 32767) return;
+    if (!(observation_path = HeapAlloc( GetProcessHeap(), 0, path_size * sizeof(WCHAR) ))) return;
+    if (!GetEnvironmentVariableW( observation_variable, observation_path, path_size )) goto done;
+
+    command_size = WideCharToMultiByte( CP_UTF8, 0, cmdline, -1, NULL, 0, NULL, NULL );
+    if (command_size <= 1) goto done;
+    process_id_size = snprintf( process_id_text, sizeof(process_id_text), "%lu\t", process_id );
+    if (process_id_size <= 0 || (SIZE_T)process_id_size >= sizeof(process_id_text)) goto done;
+
+    record_size = sizeof(record_prefix) - 1 + process_id_size + command_size - 1 + 1;
+    if (!(record = HeapAlloc( GetProcessHeap(), 0, record_size ))) goto done;
+    memcpy( record, record_prefix, sizeof(record_prefix) - 1 );
+    memcpy( record + sizeof(record_prefix) - 1, process_id_text, process_id_size );
+    if (!WideCharToMultiByte( CP_UTF8, 0, cmdline, -1,
+                              record + sizeof(record_prefix) - 1 + process_id_size,
+                              command_size, NULL, NULL )) goto done;
+
+    for (i = sizeof(record_prefix) - 1 + process_id_size;
+         i < record_size - 1; ++i)
+    {
+        if (record[i] == '\r' || record[i] == '\n' || record[i] == '\t') record[i] = ' ';
+    }
+    record[record_size - 1] = '\n';
+
+    file = CreateFileW( observation_path, FILE_APPEND_DATA,
+                        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                        NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) goto done;
+    if (WriteFile( file, record, (DWORD)record_size, &bytes_written, NULL ) &&
+        bytes_written == (DWORD)record_size) FlushFileBuffers( file );
+
+done:
+    if (file != INVALID_HANDLE_VALUE) CloseHandle( file );
+    HeapFree( GetProcessHeap(), 0, record );
+    HeapFree( GetProcessHeap(), 0, observation_path );
 }
 
 
