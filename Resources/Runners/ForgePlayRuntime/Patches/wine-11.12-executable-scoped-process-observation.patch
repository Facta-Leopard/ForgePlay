+static BOOL process_argument_is_command_line_space( WCHAR value )
+{
+    return value == L' ' || value == L'\t' || value == L'\r' || value == L'\n';
+}
+
+
+/* Chromium identifies subprocess roles with a standalone --type= argument.
+ * Parse only argument starts, including a quoted argument start, so unrelated
+ * values containing that text do not change the selected root-process scope. */
+static BOOL process_command_line_has_chromium_type_argument( const WCHAR *cmdline )
+{
+    static const WCHAR type_prefix[] = L"--type=";
+    const WCHAR *cursor = cmdline;
+
+    while (cursor && *cursor)
+    {
+        BOOL quoted = FALSE;
+
+        while (process_argument_is_command_line_space( *cursor )) ++cursor;
+        if (!*cursor) break;
+        while (*cursor == L'"')
+        {
+            quoted = !quoted;
+            ++cursor;
+        }
+        if (!wcsnicmp( cursor, type_prefix, ARRAY_SIZE(type_prefix) - 1 )) return TRUE;
+
+        while (*cursor)
+        {
+            if (*cursor == L'"') quoted = !quoted;
+            else if (!quoted && process_argument_is_command_line_space( *cursor )) break;
+            ++cursor;
+        }
+    }
+    return FALSE;
+}
+
+
+static BOOL process_argument_root_scope_allows( const WCHAR *cmdline )
+{
+    static const WCHAR root_only_variable[] = L"FORGEPLAY_PROCESS_ARGUMENT_ROOT_ONLY";
+    WCHAR value[8];
+    DWORD size;
+
+    size = GetEnvironmentVariableW( root_only_variable, value, ARRAY_SIZE(value) );
+    if (size >= ARRAY_SIZE(value)) return FALSE;
+    if (size != 1 || value[0] != L'1') return TRUE;
+    return !process_command_line_has_chromium_type_argument( cmdline );
+}
