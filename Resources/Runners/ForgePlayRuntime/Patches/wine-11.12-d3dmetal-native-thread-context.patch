+        /* D3DMetal enters libSystem directly from translated game threads.
+         * Keep Darwin's pthread context active and publish only the Windows
+         * slots that translated PE code reads directly. */
+        __asm__ volatile ("movq %%gs:%c1,%0" :
+                          "=r" (native_slot) :
+                          "n" (FIELD_OFFSET(TEB, Tib.Self)));
+        thread_data->native_slot_self = native_slot;
+        __asm__ volatile ("movq %%gs:%c1,%0" :
+                          "=r" (native_slot) :
+                          "n" (FIELD_OFFSET(TEB, ThreadLocalStoragePointer)));
+        thread_data->native_slot_tls = native_slot;
+        __asm__ volatile ("movq %%gs:%c1,%0" :
+                          "=r" (native_slot) :
+                          "n" (FIELD_OFFSET(TEB, Peb)));
+        thread_data->native_slot_peb = native_slot;
+
+        __asm__ volatile ("movq %0,%%gs:%c1" ::
+                          "r" (teb->Tib.Self),
+                          "n" (FIELD_OFFSET(TEB, Tib.Self)));
+        __asm__ volatile ("movq %0,%%gs:%c1" ::
+                          "r" (teb->ThreadLocalStoragePointer),
+                          "n" (FIELD_OFFSET(TEB, ThreadLocalStoragePointer)));
+        __asm__ volatile ("movq %0,%%gs:%c1" ::
+                          "r" (teb->Peb),
+                          "n" (FIELD_OFFSET(TEB, Peb)));
+    }
