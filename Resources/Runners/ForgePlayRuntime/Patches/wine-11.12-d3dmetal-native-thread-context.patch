+#ifdef __APPLE__
+static BOOL forgeplay_native_thread_context_enabled(void)
+{
+    const char *value = getenv( "FORGEPLAY_D3DMETAL_NATIVE_THREAD_CONTEXT" );
+    return value && value[0] == '1' && !value[1];
+}
+
+
+void forgeplay_restore_native_thread_context( struct thread_data *data )
+{
+    struct amd64_thread_data *thread_data = amd64_thread_data( data );
+
+    if (!thread_data || !thread_data->native_thread_context) return;
+    __asm__ volatile ("movq %0,%%gs:%c1" ::
+                      "r" (thread_data->native_slot_self),
+                      "n" (FIELD_OFFSET(TEB, Tib.Self)));
+    __asm__ volatile ("movq %0,%%gs:%c1" ::
+                      "r" (thread_data->native_slot_tls),
+                      "n" (FIELD_OFFSET(TEB, ThreadLocalStoragePointer)));
+    __asm__ volatile ("movq %0,%%gs:%c1" ::
+                      "r" (thread_data->native_slot_peb),
+                      "n" (FIELD_OFFSET(TEB, Peb)));
+    thread_data->native_thread_context = FALSE;
+}
+#endif
