+static BOOL fontcollection_force_replacement(struct dwrite_fontcollection *collection,
+        const WCHAR *target_name, const WCHAR *replacement_name)
+{
+    UINT32 target_index = collection_find_family(collection, target_name);
+    UINT32 replacement_index = collection_find_family(collection, replacement_name);
+    struct dwrite_fontfamily_data *target, *replacement;
+    struct dwrite_font_data **fonts;
+    WCHAR nameW[255];
+    size_t i;
+
+    if (replacement_index == ~0u)
+        return FALSE;
+    if (target_index == ~0u)
+        return fontcollection_add_replacement(collection, target_name, replacement_name);
+    if (target_index == replacement_index)
+        return TRUE;
 
+    target = collection->family_data[target_index];
+    replacement = collection->family_data[replacement_index];
+    if (!replacement->count || !(fonts = calloc(replacement->count, sizeof(*fonts))))
+        return FALSE;
+
+    for (i = 0; i < replacement->count; ++i)
+        fonts[i] = addref_font_data(replacement->fonts[i]);
+
+    for (i = 0; i < target->count; ++i)
+        release_font_data(target->fonts[i]);
+    free(target->fonts);
+
+    target->fonts = fonts;
+    target->size = target->count = replacement->count;
+    target->has_normal_face = replacement->has_normal_face;
+    target->has_oblique_face = replacement->has_oblique_face;
+    target->has_italic_face = replacement->has_italic_face;
+
+    fontstrings_get_en_string(replacement->familyname, nameW, ARRAY_SIZE(nameW));
+    TRACE("forced replacement %s -> %s\n", debugstr_w(target_name), debugstr_w(nameW));
+    return TRUE;
+}
+
+/* Replace existing family slots as well as missing aliases. This is intentionally
+   opt-in and only affects system font collections. */
+static void fontcollection_add_forced_replacements(struct dwrite_fontcollection *collection)
+{
+    DWORD max_namelen, max_datalen, i = 0, type, datalen, namelen;
+    WCHAR *name;
+    void *data;
+    HKEY hkey;
+
+    if (RegOpenKeyA(HKEY_CURRENT_USER, "Software\\Wine\\Fonts\\ForcedReplacements", &hkey))
+        return;
+
+    if (RegQueryInfoKeyW(hkey, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
+            &max_namelen, &max_datalen, NULL, NULL))
+    {
+        RegCloseKey(hkey);
+        return;
+    }
+
+    max_namelen++;
+    name = malloc(max_namelen * sizeof(WCHAR));
+    data = malloc(max_datalen ? max_datalen : sizeof(WCHAR));
+    if (!name || !data)
+    {
+        free(data);
+        free(name);
+        RegCloseKey(hkey);
+        return;
+    }
+
+    datalen = max_datalen;
+    namelen = max_namelen;
+    while (RegEnumValueW(hkey, i++, name, &namelen, NULL, &type, data, &datalen) == ERROR_SUCCESS)
+    {
+        if (type == REG_MULTI_SZ)
+        {
+            WCHAR *replacement = data;
+            while (*replacement)
+            {
+                if (fontcollection_force_replacement(collection, name, replacement))
+                    break;
+                replacement += wcslen(replacement) + 1;
+            }
+        }
+        else if (type == REG_SZ)
+            fontcollection_force_replacement(collection, name, data);
+
+        datalen = max_datalen;
+        namelen = max_namelen;
+    }
+
+    free(data);
+    free(name);
+    RegCloseKey(hkey);
+}
