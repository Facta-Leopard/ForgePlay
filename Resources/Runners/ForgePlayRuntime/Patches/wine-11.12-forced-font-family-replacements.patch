+static BOOL force_family_replacement( const WCHAR *name, const WCHAR *replace )
+{
+    struct gdi_font_family *family, *replacement;
+
+    if (!(replacement = find_family_from_any_name( replace )))
+    {
+        TRACE( "%s is not available. Skip this forced replacement.\n", debugstr_w(replace) );
+        return FALSE;
+    }
+
+    while (replacement->replacement) replacement = replacement->replacement;
+    if (!(family = find_family_from_any_name( name )) &&
+        !(family = create_family( name, NULL ))) return FALSE;
+
+    /* Resolving the replacement to its terminal family also prevents cycles. */
+    if (family == replacement) return TRUE;
+    if (family->replacement == replacement) return TRUE;
+
+    if (family->replacement) release_family( family->replacement );
+    family->replacement = replacement;
+    replacement->refcount++;
+    TRACE( "forcing %s to use %s faces\n", debugstr_w(name),
+           debugstr_w(replacement->family_name) );
+    return TRUE;
+}
