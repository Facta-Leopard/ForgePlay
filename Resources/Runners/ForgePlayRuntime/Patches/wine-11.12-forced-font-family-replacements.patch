+/*
+ * Forced replacements deliberately differ from the standard Replacements key:
+ * an installed family with the requested name is redirected too. Since font
+ * selection always follows the family replacement pointer, private faces added
+ * to that family later cannot silently bypass the mapping.
+ */
+static void load_gdi_forced_replacements(void)
+{
+    char buffer[2048];
+    KEY_VALUE_FULL_INFORMATION *info = (KEY_VALUE_FULL_INFORMATION *)buffer;
+    HKEY hkey;
+    DWORD i = 0;
+    WCHAR value[LF_FACESIZE];
+
+    static const WCHAR forced_replacementsW[] =
+        {'F','o','r','c','e','d','R','e','p','l','a','c','e','m','e','n','t','s'};
+
+    /* @@ Wine registry key: HKCU\Software\Wine\Fonts\ForcedReplacements */
+    if (!(hkey = reg_open_key( wine_fonts_key, forced_replacementsW,
+                               sizeof(forced_replacementsW) ))) return;
+
+    while (reg_enum_value( hkey, i++, info, sizeof(buffer), value, sizeof(value) ))
+    {
+        WCHAR *data = (WCHAR *)((char *)info + info->DataOffset);
+
+        if (info->Type == REG_MULTI_SZ)
+        {
+            WCHAR *replace = data;
+            while (*replace)
+            {
+                if (force_family_replacement( value, replace )) break;
+                replace += lstrlenW(replace) + 1;
+            }
+        }
+        else if (info->Type == REG_SZ) force_family_replacement( value, data );
     }
     NtClose( hkey );
 }
