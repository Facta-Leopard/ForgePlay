+static void record_forgeplay_nvapi_bootstrap(
+    NTSTATUS load_status, NTSTATUS procedure_status,
+    NTSTATUS exception_status, int initialize_result )
+{
+    UNICODE_STRING observation_path = { 0 }, nt_path = { 0 };
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    LARGE_INTEGER offset;
+    HANDLE file;
+    char record[384];
+    const char *state;
+    int record_size;
+    NTSTATUS status;
+
+    state = !load_status && !procedure_status && !exception_status &&
+        !initialize_result ? "initialized" : "failed";
+    status = get_env_var(
+        L"FORGEPLAY_PROCESS_OBSERVATION_FILE", 0, &observation_path );
+    if (status) return;
+    if (!RtlDosPathNameToNtPathName_U(
+            observation_path.Buffer, &nt_path, NULL, NULL )) goto done;
+
+    InitializeObjectAttributes(
+        &attr, &nt_path, OBJ_CASE_INSENSITIVE, 0, NULL );
+    status = NtCreateFile(
+        &file, FILE_APPEND_DATA | SYNCHRONIZE, &attr, &io, NULL,
+        FILE_ATTRIBUTE_NORMAL,
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+        FILE_OPEN_IF,
+        FILE_NON_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT,
+        NULL, 0 );
+    if (status) goto done_nt_path;
+
+    record_size = snprintf(
+        record, sizeof(record),
+        "FORGEPLAY_D3DMETAL_NVAPI_BOOTSTRAP_V1\t%lu\t"
+        "state=%s | module=nvapi64.dll | load-status=0x%08lx | "
+        "procedure-status=0x%08lx | exception-status=0x%08lx | "
+        "initialize-result=%d\n",
+        (unsigned long)HandleToULong(
+            NtCurrentTeb()->ClientId.UniqueProcess ),
+        state,
+        (unsigned long)load_status,
+        (unsigned long)procedure_status,
+        (unsigned long)exception_status,
+        initialize_result );
+    if (record_size > 0 && (SIZE_T)record_size < sizeof(record))
+    {
+        offset.QuadPart = -1;
+        if (!NtWriteFile(
+                file, NULL, NULL, NULL, &io,
+                record, record_size, &offset, NULL ))
+            NtFlushBuffersFile( file, &io );
+    }
+    NtClose( file );
+
+done_nt_path:
+    RtlFreeUnicodeString( &nt_path );
+done:
+    RtlFreeHeap( GetProcessHeap(), 0, observation_path.Buffer );
+}
+
+
+static void forgeplay_initialize_nvapi_before_game_entry(void)
+{
+#ifdef _WIN64
+    static const unsigned int nvapi_initialize_id = 0x0150e828;
+    typedef void *(CDECL *nvapi_query_interface_fn)(unsigned int);
+    typedef int (CDECL *nvapi_initialize_fn)(void);
+    UNICODE_STRING module_name;
+    ANSI_STRING query_name;
+    nvapi_query_interface_fn query_interface = NULL;
+    nvapi_initialize_fn initialize = NULL;
+    NTSTATUS load_status, procedure_status = STATUS_PROCEDURE_NOT_FOUND;
+    NTSTATUS exception_status = STATUS_SUCCESS;
+    HMODULE module = NULL;
+    void *procedure = NULL;
+    int initialize_result = -999;
+
+    if (!forgeplay_environment_flag_is_enabled(
+            L"FORGEPLAY_D3DMETAL_NVAPI_BOOTSTRAP" )) return;
+
+    RtlInitUnicodeString( &module_name, L"nvapi64.dll" );
+    load_status = LdrLoadDll( NULL, NULL, &module_name, &module );
+    if (!load_status)
+    {
+        RtlInitAnsiString( &query_name, "nvapi_QueryInterface" );
+        procedure_status = LdrGetProcedureAddress(
+            module, &query_name, 0, (void **)&query_interface );
+    }
+    if (!load_status && !procedure_status && query_interface)
+    {
+        __TRY
+        {
+            procedure = query_interface( nvapi_initialize_id );
+            if (procedure)
+            {
+                memcpy( &initialize, &procedure, sizeof(initialize) );
+                initialize_result = initialize();
+            }
+            else procedure_status = STATUS_PROCEDURE_NOT_FOUND;
+        }
+        __EXCEPT_ALL
+        {
+            exception_status = GetExceptionCode();
+        }
+        __ENDTRY
+    }
+
+    record_forgeplay_nvapi_bootstrap(
+        load_status, procedure_status,
+        exception_status, initialize_result );
+    if (load_status || procedure_status || exception_status ||
+        initialize_result)
+        WARN(
+            "ForgePlay NVAPI bootstrap failed: load %#lx, procedure %#lx, "
+            "exception %#lx, initialize %d.\n",
+            load_status, procedure_status,
+            exception_status, initialize_result );
+#endif
+}
+
+
+static void __fastcall forgeplay_thread_init_func(
+    DWORD unknown, LPTHREAD_START_ROUTINE entry, void *arg )
+{
+    if (!InterlockedCompareExchange(
+            &forgeplay_nvapi_bootstrap_state, 1, 0 ))
+    {
+        forgeplay_initialize_nvapi_before_game_entry();
+        InterlockedExchange( &forgeplay_nvapi_bootstrap_state, 2 );
+    }
+    system_BaseThreadInitThunk( unknown, entry, arg );
+}
