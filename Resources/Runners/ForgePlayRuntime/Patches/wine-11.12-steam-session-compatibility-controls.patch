+static BOOL forgeplay_renderer_path_separator( WCHAR character )
+{
+    return character == L'\\' || character == L'/';
+}
+
+
+static BOOL forgeplay_renderer_path_suffix_character_equal( WCHAR left, WCHAR right )
+{
+    return RtlUpcaseUnicodeChar( left ) == RtlUpcaseUnicodeChar( right );
+}
+
+
+static BOOL forgeplay_renderer_path_has_exact_suffix( const WCHAR *path,
+                                                       const WCHAR *suffix,
+                                                       SIZE_T suffix_length )
+{
+    SIZE_T path_index, suffix_index;
+
+    if (!path || !suffix || !suffix_length ||
+        !forgeplay_renderer_path_separator( suffix[0] )) return FALSE;
+
+    path_index = wcslen( path );
+    suffix_index = suffix_length;
+    while (suffix_index)
+    {
+        if (!path_index) return FALSE;
+        if (forgeplay_renderer_path_separator( path[path_index - 1] ) &&
+            forgeplay_renderer_path_separator( suffix[suffix_index - 1] ))
+        {
+            while (path_index &&
+                   forgeplay_renderer_path_separator( path[path_index - 1] ))
+                --path_index;
+            while (suffix_index &&
+                   forgeplay_renderer_path_separator( suffix[suffix_index - 1] ))
+                --suffix_index;
+            continue;
+        }
+        if (!forgeplay_renderer_path_suffix_character_equal(
+                path[path_index - 1], suffix[suffix_index - 1] )) return FALSE;
+        --path_index;
+        --suffix_index;
+    }
+    return TRUE;
+}
