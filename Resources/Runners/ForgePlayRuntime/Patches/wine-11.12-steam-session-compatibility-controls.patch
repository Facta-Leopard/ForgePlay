+static UINT forgeplay_network_adapter_type(void)
+{
+    char profile[32];
+    DWORD length;
+
+    length = GetEnvironmentVariableA( "FORGEPLAY_NETWORK_PROFILE", profile, ARRAY_SIZE(profile) );
+    if (!length || length >= ARRAY_SIZE(profile) || !strcmp( profile, "standard" )) return 0;
+    if (!strcmp( profile, "wifi-identity" )) return IF_TYPE_IEEE80211;
+    if (!strcmp( profile, "ethernet-identity" )) return IF_TYPE_ETHERNET_CSMACD;
+    WARN( "Ignoring unsupported ForgePlay network profile.\n" );
+    return 0;
+}
+
+static void forgeplay_normalize_network_adapter_types(
+    const NPI_MODULEID *module, DWORD table, void *static_data,
+    DWORD static_size, DWORD count )
+{
+    struct nsi_ndis_ifinfo_static *entry;
+    UINT type = forgeplay_network_adapter_type();
+    DWORD i;
+
+    if (!type || !module || table != NSI_NDIS_IFINFO_TABLE ||
+        !NmrIsEqualNpiModuleId( module, &NPI_MS_NDIS_MODULEID ) ||
+        !static_data || static_size < sizeof(*entry))
+        return;
+
+    for (i = 0; i < count; ++i)
+    {
+        entry = (struct nsi_ndis_ifinfo_static *)((BYTE *)static_data + i * static_size);
+        if (entry->type == IF_TYPE_SOFTWARE_LOOPBACK || !entry->conn_present) continue;
+        entry->type = type;
+        entry->media_type = NdisMedium802_3;
+        entry->phys_medium_type = type == IF_TYPE_IEEE80211
+            ? NdisPhysicalMediumNative802_11
+            : NdisPhysicalMedium802_3;
+    }
+}
