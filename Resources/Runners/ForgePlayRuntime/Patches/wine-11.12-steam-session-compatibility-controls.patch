+/* The host owns a bounded list of exact executable suffixes whose helper
+ * processes must remain on base Wine while their game keeps the selected
+ * renderer. This is used for architecture-incompatible service helpers, not
+ * for game-specific renderer selection or wildcard process suppression. */
+static BOOL is_forgeplay_game_renderer_base_helper( const WCHAR *path )
+{
+    static const WCHAR rules_name[] =
+        L"FORGEPLAY_GAME_RENDERER_BASE_HELPER_SUFFIX_RULES_V1";
+    WCHAR *rules, *cursor, *end, *rule;
+    DWORD size;
+    BOOL matched = FALSE;
+
+    if (!path || !*path) return FALSE;
+    size = GetEnvironmentVariableW( rules_name, NULL, 0 );
+    if (!size || size > 32767) return FALSE;
+    if (!(rules = RtlAllocateHeap(
+            GetProcessHeap(), 0, size * sizeof(WCHAR) ))) return FALSE;
+    if (!GetEnvironmentVariableW( rules_name, rules, size )) goto done;
+
+    cursor = rules;
+    end = rules + wcslen( rules );
+    while (cursor <= end)
+    {
+        SIZE_T rule_length;
+
+        rule = cursor;
+        while (cursor < end && *cursor != L';') ++cursor;
+        rule_length = cursor - rule;
+        if (rule_length && rule_length <= 1024 &&
+            forgeplay_renderer_path_has_exact_suffix(
+                path, rule, rule_length ))
+        {
+            matched = TRUE;
+            break;
+        }
+        if (cursor == end) break;
+        ++cursor;
+    }
+
+done:
+    RtlFreeHeap( GetProcessHeap(), 0, rules );
+    return matched;
+}
