+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#include "windef.h"
+#include "winternl.h"
+#include "unix_private.h"
+
+#include "wine/debug.h"
+#include "wine/unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(module);
+
+typedef bool (*supports_non_native_code_regions_t)( void );
+typedef void (*register_non_native_code_region_t)( void *start, void *end );
+
+static void *d3dshared_handle;
+static register_non_native_code_region_t register_non_native_code_region;
+static BOOL activation_checked;
+
+static BOOL selector_matches( const UNICODE_STRING *main_image )
+{
+    const char *enabled = getenv( "FORGEPLAY_D3DMETAL_BRIDGE" );
+    const char *target = getenv( "FORGEPLAY_D3DMETAL_TARGET" );
+    const WCHAR *basename, *end;
+    WCHAR *targetW;
+    SIZE_T target_bytes, target_len, basename_len;
+    BOOL matches;
+
+    if (!enabled || strcmp( enabled, "1" ) || !target || !target[0]) return FALSE;
+    if (strchr( target, '/' ) || strchr( target, '\\' ))
+    {
+        WARN( "FORGEPLAY_D3DMETAL_TARGET must be a main-image basename\n" );
+        return FALSE;
+    }
+
+    end = main_image->Buffer + main_image->Length / sizeof(WCHAR);
+    basename = main_image->Buffer;
+    for (const WCHAR *cursor = basename; cursor < end; cursor++)
+        if (*cursor == '/' || *cursor == '\\') basename = cursor + 1;
+    basename_len = end - basename;
+
+    target_bytes = strlen( target );
+    if (!(targetW = malloc( max( target_bytes, 1 ) * sizeof(*targetW) ))) return FALSE;
+    target_len = ntdll_umbstowcs( target, target_bytes, targetW, target_bytes );
+    matches = target_len == basename_len && !wcsnicmp( targetW, basename, target_len );
+    free( targetW );
+    return matches;
+}
+
+static void load_registration_capability(void)
+{
+    const char *library = getenv( "FORGEPLAY_D3DMETAL_SHARED_LIBRARY" );
+    supports_non_native_code_regions_t supports_non_native_code_regions;
+    register_non_native_code_region_t register_region;
+    void *handle;
+
+    if (library && library[0] != '/')
+    {
+        WARN( "FORGEPLAY_D3DMETAL_SHARED_LIBRARY must be an absolute path\n" );
+        return;
+    }
+    if (!library || !library[0]) library = "libd3dshared.dylib";
+
+    if (!(handle = dlopen( library, RTLD_LAZY | RTLD_LOCAL )))
+    {
+        WARN( "failed to load %s: %s\n", debugstr_a(library), dlerror() );
+        return;
+    }
+
+    supports_non_native_code_regions = dlsym( handle, "supports_non_native_code_regions" );
+    register_region = dlsym( handle, "register_non_native_code_region" );
+    if (!supports_non_native_code_regions || !register_region)
+    {
+        WARN( "%s does not expose non-native code-region registration\n", debugstr_a(library) );
+        dlclose( handle );
+        return;
+    }
+    if (!supports_non_native_code_regions())
+    {
+        TRACE( "%s reports that non-native code-region registration is unnecessary\n",
+               debugstr_a(library) );
+        dlclose( handle );
+        return;
+    }
+
+    d3dshared_handle = handle;
+    register_non_native_code_region = register_region;
+    TRACE( "enabled non-native PE image registration through %s\n", debugstr_a(library) );
+}
+
+void forgeplay_d3dmetal_register_image( void *base, SIZE_T size )
+{
+    uintptr_t start = (uintptr_t)base;
+
+    if (!register_non_native_code_region || !base || !size) return;
+    if (size > UINTPTR_MAX - start)
+    {
+        WARN( "refusing overflowing PE image range %p + %lu\n", base, (unsigned long)size );
+        return;
+    }
+    register_non_native_code_region( base, (void *)(start + size) );
+}
+
+void forgeplay_d3dmetal_activate( const UNICODE_STRING *main_image, void *base, SIZE_T size )
+{
+    if (activation_checked) return;
+    activation_checked = TRUE;
+    if (!selector_matches( main_image )) return;
+
+    load_registration_capability();
+    forgeplay_d3dmetal_register_image( base, size );
+}
