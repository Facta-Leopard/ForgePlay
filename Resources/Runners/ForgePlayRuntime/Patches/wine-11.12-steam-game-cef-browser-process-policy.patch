+static BOOL forgeplay_wide_contains_case_insensitive( const WCHAR *text, const WCHAR *needle )
+{
+    SIZE_T text_length, needle_length, i, j;
+
+    if (!text || !needle) return FALSE;
+    text_length = wcslen( text );
+    needle_length = wcslen( needle );
+    if (!needle_length || needle_length > text_length) return FALSE;
+    for (i = 0; i <= text_length - needle_length; ++i)
+    {
+        for (j = 0; j < needle_length; ++j)
+        {
+            WCHAR left = text[i + j], right = needle[j];
+            if (left >= L'A' && left <= L'Z') left += L'a' - L'A';
+            if (right >= L'A' && right <= L'Z') right += L'a' - L'A';
+            if (left != right) break;
+        }
+        if (j == needle_length) return TRUE;
+    }
+    return FALSE;
+}
+
+
+static BOOL forgeplay_ascii_buffer_contains_case_insensitive(
+    const BYTE *bytes, SIZE_T size, const char *needle )
+{
+    SIZE_T needle_length = strlen( needle ), i, j;
+
+    if (!needle_length || needle_length > size) return FALSE;
+    for (i = 0; i <= size - needle_length; ++i)
+    {
+        for (j = 0; j < needle_length; ++j)
+        {
+            BYTE left = bytes[i + j], right = needle[j];
+            if (left >= 'A' && left <= 'Z') left += 'a' - 'A';
+            if (right >= 'A' && right <= 'Z') right += 'a' - 'A';
+            if (left != right) break;
+        }
+        if (j == needle_length) return TRUE;
+    }
+    return FALSE;
+}
