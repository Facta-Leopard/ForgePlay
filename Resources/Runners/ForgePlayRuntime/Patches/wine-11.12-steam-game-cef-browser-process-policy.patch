+static WCHAR *append_forgeplay_steam_game_cef_browser_argument(
+    const WCHAR *filename, const WCHAR *cur_dir, const WCHAR *cmdline )
+{
+    static const WCHAR process_type_argument[] = L"--type=";
+    static const WCHAR in_process_gpu_argument[] = L"--in-process-gpu";
+    WCHAR *result;
+    SIZE_T result_size;
+    DWORD saved_error = GetLastError();
+
+    if (!forgeplay_steam_game_cef_browser_policy_enabled() ||
+        is_forgeplay_game_renderer_excluded_role( filename ) ||
+        (!is_forgeplay_steam_game_path( filename ) &&
+         !is_forgeplay_steam_game_path( cur_dir )) ||
+        forgeplay_wide_contains_case_insensitive( cmdline, process_type_argument ) ||
+        forgeplay_wide_contains_case_insensitive( cmdline, in_process_gpu_argument ) ||
+        !forgeplay_pe_contains_ascii_marker( filename, cur_dir, "libcef.dll" ))
+    {
+        SetLastError( saved_error );
+        return NULL;
+    }
+
+    result_size = wcslen( cmdline ) + ARRAY_SIZE(in_process_gpu_argument) + 1;
+    if (result_size > 32767 ||
+        !(result = HeapAlloc( GetProcessHeap(), 0, result_size * sizeof(WCHAR) )))
+    {
+        SetLastError( saved_error );
+        return NULL;
+    }
+    swprintf( result, result_size, L"%s %s", cmdline, in_process_gpu_argument );
+    TRACE( "enabled in-process GPU for Steam game CEF browser process %s\n",
+           debugstr_w(filename) );
+    SetLastError( saved_error );
+    return result;
+}
