+static enum vkd3d_result vsir_program_init_unwritten_output_components(struct vsir_program *program,
+        const struct signature_element *e, unsigned int mask)
+{
+    struct vsir_program_iterator it = vsir_program_iterator(&program->instructions);
+    struct vkd3d_shader_instruction *ins;
+    struct vkd3d_shader_location loc;
+
+    for (ins = vsir_program_iterator_head(&it); ins; ins = vsir_program_iterator_next(&it))
+    {
+        if (ins->opcode != VSIR_OP_RET)
+            continue;
+
+        loc = ins->location;
+        if (!(ins = vsir_program_iterator_insert_before_and_move(&it, 1)))
+            return VKD3D_ERROR_OUT_OF_MEMORY;
+        if (!vsir_instruction_init_with_params(program, ins, &loc, VSIR_OP_MOV, 1, 1))
+        {
+            vkd3d_shader_instruction_make_nop(ins);
+            return VKD3D_ERROR_OUT_OF_MEMORY;
+        }
+
+        vsir_dst_operand_init_output(&ins->dst[0], VSIR_DATA_F32, e->register_index, mask);
+        vsir_src_operand_init(&ins->src[0], VKD3DSPR_IMMCONST, VSIR_DATA_F32, 0);
+        ins->src[0].reg.dimension = VSIR_DIMENSION_VEC4;
+        ins->src[0].swizzle = VKD3D_SHADER_NO_SWIZZLE;
+
+        /* Advance past the inserted instruction to the original ret. */
+        vsir_program_iterator_next(&it);
+    }
+
+    return VKD3D_OK;
+}
