 }

+static BOOL forgeplay_environment_flag_enabled( const char *name )
+{
+    const char *value = getenv( name );
+    return value && value[0] == '1' && !value[1];
+}
+
+static BOOL forgeplay_game_mode_identifier_is_valid( const char *value )
+{
+    size_t i;
+
+    if (!value || strlen( value ) != 36) return FALSE;
+    for (i = 0; value[i]; ++i)
+    {
+        if ((value[i] >= '0' && value[i] <= '9') ||
+            (value[i] >= 'a' && value[i] <= 'f') || value[i] == '-') continue;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL forgeplay_game_mode_value_is_bounded( const char *value, size_t maximum )
+{
+    size_t length;
+
+    if (!value || !*value) return FALSE;
+    length = strnlen( value, maximum + 1 );
+    return length > 0 && length <= maximum;
+}
+
+static BOOL forgeplay_game_mode_host_is_safe( const char *path )
+{
+    static const char suffix[] =
+        "/Contents/Helpers/GameModeProcessHost.app/Contents/MacOS/GameModeProcessHost";
+    struct stat status;
+    char resolved[PATH_MAX];
+    size_t length, suffix_length = sizeof(suffix) - 1;
+
+    if (!forgeplay_game_mode_value_is_bounded( path, PATH_MAX - 1 ) || path[0] != '/') return FALSE;
+    if (!realpath( path, resolved ) || strcmp( path, resolved )) return FALSE;
+    length = strlen( resolved );
+    if (length <= suffix_length || strcmp( resolved + length - suffix_length, suffix )) return FALSE;
+    if (lstat( resolved, &status ) == -1 || !S_ISREG( status.st_mode ) ||
+        status.st_nlink != 1 || !(status.st_mode & S_IXUSR)) return FALSE;
+    return TRUE;
+}
+
+static void forgeplay_record_game_mode_loader_event( const char *event, int error )
+{
+    const char *evidence = getenv( "FORGEPLAY_GAME_MODE_HOST_EVIDENCE_FILE" );
+    const char *run_id = getenv( "FORGEPLAY_GAME_MODE_HOST_RUN_ID" );
+    struct stat status;
+    char record[384];
+    int descriptor, length;
+
+    if (!event || !forgeplay_game_mode_identifier_is_valid( run_id ) ||
+        !forgeplay_game_mode_value_is_bounded( evidence, PATH_MAX - 1 ) || evidence[0] != '/') return;
+    descriptor = open( evidence, O_WRONLY | O_APPEND | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600 );
+    if (descriptor == -1) return;
+    if (flock( descriptor, LOCK_EX ) == -1 ||
+        fstat( descriptor, &status ) == -1 || !S_ISREG( status.st_mode ) ||
+        status.st_nlink != 1 || status.st_uid != geteuid())
+    {
+        flock( descriptor, LOCK_UN );
+        close( descriptor );
+        return;
+    }
+    length = snprintf(
+        record, sizeof(record),
+        "{\"schema_version\":1,\"producer\":\"wine-loader\","
+        "\"event_code\":\"%s\",\"run_identifier\":\"%s\","
+        "\"darwin_pid\":%ld,\"error_code\":%d}\n",
+        event, run_id, (long)getpid(), error );
+    if (length > 0 && (size_t)length < sizeof(record))
+    {
+        ssize_t written;
+        size_t offset = 0;
+        while (offset < (size_t)length)
+        {
+            written = write( descriptor, record + offset, length - offset );
+            if (written > 0) offset += written;
+            else if (written == -1 && errno == EINTR) continue;
+            else break;
+        }
+        fsync( descriptor );
+    }
+    flock( descriptor, LOCK_UN );
+    close( descriptor );
+}
+
+/* Steam remains the Windows parent and creates the canonical game process.
+ * Game lineage is independent of renderer selection, so a deferred, Vulkan,
+ * or otherwise non-Direct3D child can use the same fixed host. argv, cwd,
+ * inherited handles, server socket, and the Darwin PID are preserved by exec. */
+static NTSTATUS forgeplay_exec_required_game_mode_host( char **argv )
+{
+    const char *mode, *host, *bundle_id, *host_hash, *ntdll, *evidence, *lock, *run_id;
+    char *host_argument;
+    int saved_error;
+
+    if (!forgeplay_environment_flag_enabled( "FORGEPLAY_STEAM_GAME_PROCESS" ))
+        return STATUS_SUCCESS;
+    if (!forgeplay_environment_flag_enabled( "FORGEPLAY_GAME_MODE_HOST_ENABLED" ))
+    {
+        forgeplay_record_game_mode_loader_event(
+            "loader_route_skipped_game_mode_not_requested", 0 );
+        unsetenv( "FORGEPLAY_GAME_MODE_DIRECT_TARGET" );
+        return STATUS_SUCCESS;
+    }
+
+    mode = getenv( "FORGEPLAY_GAME_MODE_HOST_MODE" );
+    host = getenv( "FORGEPLAY_GAME_MODE_HOST_EXECUTABLE" );
+    bundle_id = getenv( "FORGEPLAY_GAME_MODE_HOST_BUNDLE_IDENTIFIER" );
+    host_hash = getenv( "FORGEPLAY_GAME_MODE_HOST_EXECUTABLE_SHA256" );
+    ntdll = getenv( "FORGEPLAY_GAME_MODE_HOST_NTDLL" );
+    evidence = getenv( "FORGEPLAY_GAME_MODE_HOST_EVIDENCE_FILE" );
+    run_id = getenv( "FORGEPLAY_GAME_MODE_HOST_RUN_ID" );
+    lock = getenv( "FORGEPLAY_PREFIX_EXECUTION_LOCK" );
+
+    if (!mode || strcmp( mode, "steam-child" ) ||
+        !forgeplay_game_mode_host_is_safe( host ) ||
+        !forgeplay_game_mode_value_is_bounded( bundle_id, 255 ) ||
+        !forgeplay_game_mode_value_is_bounded( host_hash, 64 ) || strlen( host_hash ) != 64 ||
+        !forgeplay_game_mode_value_is_bounded( ntdll, PATH_MAX - 1 ) || ntdll[0] != '/' ||
+        !forgeplay_game_mode_value_is_bounded( evidence, PATH_MAX - 1 ) || evidence[0] != '/' ||
+        !forgeplay_game_mode_identifier_is_valid( run_id ) ||
+        !forgeplay_game_mode_value_is_bounded( lock, PATH_MAX - 1 ) || lock[0] != '/')
+    {
+        forgeplay_record_game_mode_loader_event( "loader_contract_rejected", EINVAL );
+        return STATUS_INVALID_PARAMETER;
+    }
+
+    host_argument = strdup( host );
+    if (!host_argument)
+    {
+        forgeplay_record_game_mode_loader_event( "loader_allocation_failed", ENOMEM );
+        return STATUS_NO_MEMORY;
+    }
+    setenv( "FORGEPLAY_GAME_MODE_HOST_ROUTED", "1", 1 );
+    forgeplay_record_game_mode_loader_event( "loader_route_selected", 0 );
+    argv[1] = host_argument;
+    execv( argv[1], argv + 1 );
+    saved_error = errno;
+    forgeplay_record_game_mode_loader_event( "loader_exec_failed", saved_error );
+    free( host_argument );
+    argv[1] = NULL;
+    unsetenv( "FORGEPLAY_GAME_MODE_HOST_ROUTED" );
+    errno = saved_error;
+    return STATUS_UNSUCCESSFUL;
+}
+
 /* exec the appropriate wine loader for the specified machine */
 static NTSTATUS loader_exec( char **argv, WORD machine )
 {
     static char noexec[] = "WINELOADERNOEXEC=1";
+    NTSTATUS status;

     putenv( noexec );
+    if ((status = forgeplay_exec_required_game_mode_host( argv ))) return status;

     if (((argv[1] = get_alternate_wineloader( machine )))) preloader_exec( argv );

