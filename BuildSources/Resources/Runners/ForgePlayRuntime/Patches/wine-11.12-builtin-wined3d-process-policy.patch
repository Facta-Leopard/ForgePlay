+/* This is a host-selected builtin policy, not an inactive renderer. The
+ * active process marker is checked independently by each caller. */
+static BOOL forgeplay_game_renderer_is_wined3d(void)
+{
+    UNICODE_STRING policy = { 0 };
+    BOOL result;
+
+    if (get_env_var( L"FORGEPLAY_GAME_RENDERER_POLICY", 0, &policy )) return FALSE;
+    result = policy.Length == sizeof(L"wined3d") - sizeof(WCHAR) &&
+        !wcscmp( policy.Buffer, L"wined3d" );
+    RtlFreeHeap( GetProcessHeap(), 0, policy.Buffer );
+    return result;
+}
