+
+static BOOL forgeplay_identity_value_is_bounded( const char *value, SIZE_T maximum )
+{
+    SIZE_T index;
+
+    if (!value) return FALSE;
+    for (index = 0; index <= maximum; ++index)
+    {
+        unsigned char character = value[index];
+
+        if (!character) return index != 0;
+        if (character < 0x20 || character > 0x7e) return FALSE;
+    }
+    return FALSE;
+}
+
+static BOOL forgeplay_parse_pci_identifier( const char *value, UINT16 *result )
+{
+    unsigned int parsed = 0;
+    SIZE_T index;
+
+    if (!value || !result || strlen( value ) != 6 || value[0] != '0' ||
+        (value[1] != 'x' && value[1] != 'X')) return FALSE;
+    for (index = 2; index < 6; ++index)
+    {
+        unsigned int digit;
+
+        if (value[index] >= '0' && value[index] <= '9') digit = value[index] - '0';
+        else if (value[index] >= 'a' && value[index] <= 'f') digit = value[index] - 'a' + 10;
+        else if (value[index] >= 'A' && value[index] <= 'F') digit = value[index] - 'A' + 10;
+        else return FALSE;
+        parsed = (parsed << 4) | digit;
+    }
+    *result = parsed;
+    return TRUE;
+}
+
+static BOOL forgeplay_parse_driver_version( const char *value, unsigned int components,
+                                            UINT64 *packed )
+{
+    const char *cursor = value;
+    UINT64 result = 0;
+    unsigned int component;
+
+    if (!value || !components || components > 4) return FALSE;
+    for (component = 0; component < components; ++component)
+    {
+        unsigned int part = 0;
+
+        if (*cursor < '0' || *cursor > '9') return FALSE;
+        do
+        {
+            unsigned int digit = *cursor++ - '0';
+            if (part > (0xffffu - digit) / 10u) return FALSE;
+            part = part * 10u + digit;
+        } while (*cursor >= '0' && *cursor <= '9');
+
+        result = (result << 16) | part;
+        if (component + 1 < components)
+        {
+            if (*cursor++ != '.') return FALSE;
+        }
+        else if (*cursor) return FALSE;
+    }
+    if (packed) *packed = result;
+    return TRUE;
+}
