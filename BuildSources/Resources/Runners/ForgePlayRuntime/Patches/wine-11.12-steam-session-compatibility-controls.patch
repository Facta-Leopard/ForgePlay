+/*
+ * ForgePlay owns one NVIDIA identity tuple.  A routed game child receives the
+ * direct variables; the Steam base process receives the same tuple through
+ * the renderer control plane so its early display enumeration cannot rewrite
+ * the shared prefix back to the Apple host identity.  Never mix the two sets:
+ * a partial tuple is an inactive policy, not permission to synthesize fields.
+ */
+static BOOL forgeplay_get_nvidia_identity( struct forgeplay_nvidia_identity *identity )
+{
+    static const char *actual_names[] =
+    {
+        "FORGEPLAY_NVIDIA_IDENTITY_PROFILE",
+        "FORGEPLAY_NVIDIA_IDENTITY_VENDOR_ID",
+        "FORGEPLAY_NVIDIA_IDENTITY_DEVICE_ID",
+        "FORGEPLAY_NVIDIA_IDENTITY_DEVICE_NAME",
+        "FORGEPLAY_NVIDIA_IDENTITY_DRIVER_VERSION",
+        "FORGEPLAY_NVIDIA_IDENTITY_DISPLAY_DRIVER_VERSION",
+    };
+    static const char *projected_names[] =
+    {
+        "FORGEPLAY_GAME_RENDERER_ENV_FORGEPLAY_NVIDIA_IDENTITY_PROFILE",
+        "FORGEPLAY_GAME_RENDERER_ENV_FORGEPLAY_NVIDIA_IDENTITY_VENDOR_ID",
+        "FORGEPLAY_GAME_RENDERER_ENV_FORGEPLAY_NVIDIA_IDENTITY_DEVICE_ID",
+        "FORGEPLAY_GAME_RENDERER_ENV_FORGEPLAY_NVIDIA_IDENTITY_DEVICE_NAME",
+        "FORGEPLAY_GAME_RENDERER_ENV_FORGEPLAY_NVIDIA_IDENTITY_DRIVER_VERSION",
+        "FORGEPLAY_GAME_RENDERER_ENV_FORGEPLAY_NVIDIA_IDENTITY_DISPLAY_DRIVER_VERSION",
+    };
+    const char *values[ARRAY_SIZE(actual_names)] = {0};
+    const char *requested = getenv( "FORGEPLAY_GAME_RENDERER_REQUESTED" );
+    BOOL any_actual = FALSE;
+    unsigned int index;
+
+    if (!identity) return FALSE;
+    memset( identity, 0, sizeof(*identity) );
+    for (index = 0; index < ARRAY_SIZE(actual_names); ++index)
+        if ((values[index] = getenv( actual_names[index] ))) any_actual = TRUE;
+    if (!any_actual)
+    {
+        if (!requested || strcmp( requested, "d3dMetalNVIDIA" )) return FALSE;
+        for (index = 0; index < ARRAY_SIZE(projected_names); ++index)
+            values[index] = getenv( projected_names[index] );
+    }
+
+    if (!forgeplay_identity_value_is_bounded( values[0], 64 ) ||
+        !forgeplay_parse_pci_identifier( values[1], &identity->vendor ) ||
+        !forgeplay_parse_pci_identifier( values[2], &identity->device ) ||
+        !forgeplay_identity_value_is_bounded( values[3], 127 ) ||
+        !forgeplay_identity_value_is_bounded( values[4], 31 ) ||
+        !forgeplay_identity_value_is_bounded( values[5], 31 ) ||
+        !forgeplay_parse_driver_version( values[4], 2, NULL ) ||
+        !forgeplay_parse_driver_version(
+            values[5], 4, &identity->packed_display_driver_version ))
+    {
+        WARN( "Ignoring incomplete or invalid ForgePlay NVIDIA identity policy.\n" );
+        memset( identity, 0, sizeof(*identity) );
+        return FALSE;
+    }
+
+    identity->profile = values[0];
+    identity->device_name = values[3];
+    identity->user_mode_driver_version = values[4];
+    identity->display_driver_version = values[5];
+    return TRUE;
+}
