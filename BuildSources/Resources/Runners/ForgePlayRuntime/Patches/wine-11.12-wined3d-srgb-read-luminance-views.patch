+VkFormat wined3d_texture_vk_get_srgb_format(const struct wined3d_texture_vk *texture_vk)
+{
+    switch (wined3d_format_vk(texture_vk->t.resource.format)->vk_format)
+    {
+        case VK_FORMAT_R8G8B8A8_UNORM: return VK_FORMAT_R8G8B8A8_SRGB;
+        case VK_FORMAT_B8G8R8A8_UNORM: return VK_FORMAT_B8G8R8A8_SRGB;
+        case VK_FORMAT_BC1_RGB_UNORM_BLOCK: return VK_FORMAT_BC1_RGB_SRGB_BLOCK;
+        case VK_FORMAT_BC1_RGBA_UNORM_BLOCK: return VK_FORMAT_BC1_RGBA_SRGB_BLOCK;
+        case VK_FORMAT_BC2_UNORM_BLOCK: return VK_FORMAT_BC2_SRGB_BLOCK;
+        case VK_FORMAT_BC3_UNORM_BLOCK: return VK_FORMAT_BC3_SRGB_BLOCK;
+        case VK_FORMAT_BC7_UNORM_BLOCK: return VK_FORMAT_BC7_SRGB_BLOCK;
+        default: return VK_FORMAT_UNDEFINED;
+    }
+}
+
+const VkDescriptorImageInfo *wined3d_texture_vk_get_default_image_info(struct wined3d_texture_vk *texture_vk,
+        struct wined3d_context_vk *context_vk)
+{
+    return wined3d_texture_vk_get_image_info(texture_vk, context_vk,
+            wined3d_format_vk(texture_vk->t.resource.format)->vk_format, &texture_vk->default_image_info, NULL);
+}
+
+const VkDescriptorImageInfo *wined3d_texture_vk_get_srgb_image_info(struct wined3d_texture_vk *texture_vk,
+        struct wined3d_context_vk *context_vk, const struct wined3d_view_desc *desc)
+{
+    const struct wined3d_vk_info *vk_info = context_vk->vk_info;
+    VkFormat format = wined3d_texture_vk_get_srgb_format(texture_vk);
+    VkFormatProperties properties;
+
+    if (format == VK_FORMAT_UNDEFINED)
+        return NULL;
+    if (!texture_vk->srgb_image_info.imageView)
+    {
+        VK_CALL(vkGetPhysicalDeviceFormatProperties(wined3d_adapter_vk(texture_vk->t.resource.device->adapter)->physical_device,
+                format, &properties));
+        if (!(properties.optimalTilingFeatures & VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT))
+        {
+            ERR("sRGB sampling format %u is not supported.\n", format);
+            return NULL;
+        }
+    }
+    return wined3d_texture_vk_get_image_info(texture_vk, context_vk, format, &texture_vk->srgb_image_info, desc);
 }
 
