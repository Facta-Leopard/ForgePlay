+		NSUInteger encoderCount = hasEncoderArray ? [encoderInfo count] : 0;
+		const char* encoderState = !encoderInfo ? "absent" : !hasEncoderArray ? "unexpected-type" : encoderCount ? "present" : "empty";
+		id underlyingValue = userInfo[NSUnderlyingErrorKey];
