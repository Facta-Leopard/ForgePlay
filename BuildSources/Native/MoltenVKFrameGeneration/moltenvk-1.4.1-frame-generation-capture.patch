+// ForgePlay modification, Copyright 2026 Facta-Leopard, Apache-2.0.
+// Bind the exact drawable to its uncommitted writer without changing Vulkan's
+// scheduled presentation, presentation timing, or semaphore/fence lifecycle.
+static void mvkForgePlayBindSourceDrawable(void* drawable, void* commandBuffer) {
+	const char* enabled = getenv("FORGEPLAY_D3DMETAL_FRAME_GENERATION");
+	if (!enabled || strcmp(enabled, "1") || !drawable || !commandBuffer) { return; }
+
+	using BindSourceDrawable = int (*)(void*, void*);
+	static std::atomic<BindSourceDrawable> cachedBinder{nullptr};
+	auto binder = cachedBinder.load(std::memory_order_acquire);
+	if (!binder) {
+		const char* path = getenv("FORGEPLAY_D3DMETAL_FRAME_GENERATION_PROXY");
+		static const char suffix[] = "/ForgePlayD3DMetalFrameGenerationProxy.dylib";
+		char canonical[PATH_MAX];
+		struct stat metadata;
+		if (!path || path[0] != '/') { return; }
+		size_t length = strlen(path);
+		if (length < sizeof(suffix) - 1 || length >= sizeof(canonical) ||
+			strcmp(path + length - (sizeof(suffix) - 1), suffix) ||
+			lstat(path, &metadata) || !S_ISREG(metadata.st_mode) || metadata.st_nlink != 1 ||
+			metadata.st_uid != geteuid() || (metadata.st_mode & (S_IWGRP | S_IWOTH)) ||
+			!realpath(path, canonical) || strcmp(path, canonical)) { return; }
+
+		// Wine owns the validated proxy handle for the lifetime of this process.
+		// NOLOAD cannot introduce a new library from the environment path.
+		void* handle = dlopen(path, RTLD_LAZY | RTLD_NOLOAD);
+		if (!handle) { return; }
+		void* symbol = dlsym(handle, "FPD3DMetalFrameGenerationProxyBindSourceDrawableV1");
+		Dl_info owner = {};
+		if (symbol && dladdr(symbol, &owner) && owner.dli_fname &&
+			realpath(owner.dli_fname, canonical) && !strcmp(path, canonical)) {
+			binder = reinterpret_cast<BindSourceDrawable>(symbol);
+			cachedBinder.store(binder, std::memory_order_release);
+		}
+		dlclose(handle);
+		// Do not cache a miss: the first drawable can precede proxy attachment.
+	}
+	if (binder) { (void)binder(drawable, commandBuffer); }
+}
+#endif
 
