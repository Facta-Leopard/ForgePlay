+// ForgePlay opt-in error diagnostics, Copyright 2026 Facta-Leopard, Apache-2.0.
+// Identifiers only: bound output and replace non-printable/non-ASCII characters
+// so an NSError key or domain cannot inject additional log lines.
+template<size_t N>
+static void mvkForgePlayCopyErrorIdentifier(NSString* identifier, char (&buffer)[N]) {
+	if (!identifier) { identifier = @"<none>"; }
+	NSUInteger count = identifier.length;
+	if (count >= N) { count = N - 1; }
+	for (NSUInteger idx = 0; idx < count; idx++) {
+		unichar ch = [identifier characterAtIndex: idx];
+		buffer[idx] = ch >= 0x20 && ch <= 0x7e ? (char)ch : '?';
+	}
+	buffer[count] = 0;
+}
