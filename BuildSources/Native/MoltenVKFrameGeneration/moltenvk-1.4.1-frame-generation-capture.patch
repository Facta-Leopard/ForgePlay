+		mvkForgePlayCopyErrorIdentifier(underlying.domain, underlyingDomain);
+		MVKLogInfo("ForgePlay GPU failure diagnostics: errorOptions=0x%lx retainedReferences=%u errorDomain=%s errorCode=%li userInfoKeyCount=%lu encoderInfo=%s encoderCount=%lu underlyingError=%s underlyingDomain=%s underlyingCode=%li",
+				   (unsigned long)mtlCmdBuff.errorOptions, (unsigned)mtlCmdBuff.retainedReferences,
+				   domain, (long)error.code, (unsigned long)userInfo.count, encoderState, (unsigned long)encoderCount,
+				   underlyingState, underlyingDomain, (long)underlying.code);
+		NSUInteger shownKeys = 0;
+		for (id key in userInfo) {
+			if (shownKeys == 16) { break; }
+			char keyName[96];
+			mvkForgePlayCopyErrorIdentifier([key isKindOfClass: [NSString class]] ? (NSString*)key : @"<non-string-key>", keyName);
+			MVKLogInfo(" - NSError userInfo key[%lu]=%s", (unsigned long)shownKeys++, keyName);
