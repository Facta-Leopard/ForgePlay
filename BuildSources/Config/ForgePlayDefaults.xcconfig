// Modified native-only source supplement defaults for ForgePlay 1.3 (4).
// No local configuration or signing credentials are included.
// Supply recipient-owned identifiers/signing settings through xcodebuild overrides.

FORGEPLAY_MARKETING_VERSION = 1.3
FORGEPLAY_CURRENT_PROJECT_VERSION = 4
FORGEPLAY_DEVELOPMENT_TEAM =
FORGEPLAY_CODE_SIGN_STYLE = Automatic
FORGEPLAY_ENABLE_HARDENED_RUNTIME = YES
FORGEPLAY_PRODUCT_NAME = ForgePlay
FORGEPLAY_APP_BUNDLE_ID = com.forgeplay.client
FORGEPLAY_DISTRIBUTION_BUNDLE_ID = $(FORGEPLAY_APP_BUNDLE_ID)
FORGEPLAY_APP_STORE_BUNDLE_ID = com.forgeplay.client


MARKETING_VERSION = $(FORGEPLAY_MARKETING_VERSION)
CURRENT_PROJECT_VERSION = $(FORGEPLAY_CURRENT_PROJECT_VERSION)
DEVELOPMENT_TEAM = $(FORGEPLAY_DEVELOPMENT_TEAM)
CODE_SIGN_STYLE = $(FORGEPLAY_CODE_SIGN_STYLE)
ENABLE_HARDENED_RUNTIME = $(FORGEPLAY_ENABLE_HARDENED_RUNTIME)
