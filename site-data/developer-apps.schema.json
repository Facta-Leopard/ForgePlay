{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facta-leopard.github.io/ForgePlay/site-data/developer-apps.schema.json",
  "title": "ForgePlay developer app catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "sourceRevision", "apps", "inDevelopment"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "apps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/app"
      }
    },
    "inDevelopment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en", "de", "es", "fr", "ja", "zh-Hans", "zh-Hant"],
      "properties": {
        "ko": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 },
        "fr": { "type": "string", "minLength": 1 },
        "ja": { "type": "string", "minLength": 1 },
        "zh-Hans": { "type": "string", "minLength": 1 },
        "zh-Hant": { "type": "string", "minLength": 1 }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "appStoreID",
        "name",
        "platform",
        "kind",
        "summaries",
        "supportedLanguages",
        "appleSiliconMacCompatible",
        "artwork",
        "href"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "appStoreID": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": ["mac", "ipad", "iphone"]
        },
        "kind": {
          "enum": ["app", "game"]
        },
        "summaries": {
          "$ref": "#/$defs/localizedText"
        },
        "supportedLanguages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "appleSiliconMacCompatible": {
          "type": "boolean"
        },
        "artwork": {
          "type": "string",
          "pattern": "^site-assets/(?:developer-apps/[a-z0-9-]+\\.(?:png|jpg)|forgeplay-icon\\.png)$"
        },
        "href": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^https://apps\\.apple\\.com/us/app/[a-z0-9-]+/id[0-9]+$"
            },
            {
              "const": "index.html"
            }
          ]
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "platform", "kind", "artwork"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": ["mac", "ipad", "iphone"]
        },
        "kind": {
          "enum": ["app", "utility", "game"]
        },
        "summaries": {
          "$ref": "#/$defs/localizedText"
        },
        "artwork": {
          "type": "string",
          "pattern": "^site-assets/developer-apps/[a-z0-9-]+\\.png$"
        }
      }
    }
  }
}
