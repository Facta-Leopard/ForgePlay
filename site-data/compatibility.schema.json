{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facta-leopard.github.io/ForgePlay/site-data/compatibility.schema.json",
  "title": "ForgePlay compatibility database",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updatedAt",
    "testProfiles",
    "games",
    "reports"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "testProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testProfile"
      }
    },
    "games": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/game"
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/report"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "testProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform",
        "chip",
        "unifiedMemoryGB",
        "macOSVersion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "chip": {
          "type": "string",
          "minLength": 1
        },
        "unifiedMemoryGB": {
          "type": "integer",
          "minimum": 1
        },
        "macOSVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titles"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "titles": {
          "$ref": "#/$defs/localizedText"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gameId",
        "testProfileId",
        "status",
        "source",
        "testedAt",
        "notes",
        "blocker"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "gameId": {
          "$ref": "#/$defs/identifier"
        },
        "testProfileId": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "playable",
            "testing",
            "blocked",
            "unknown"
          ]
        },
        "source": {
          "enum": [
            "project-test",
            "community-report"
          ]
        },
        "testedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "notes": {
          "anyOf": [
            {
              "$ref": "#/$defs/localizedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocker": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "anti-cheat",
            "launcher",
            "graphics",
            "runtime",
            "unknown",
            null
          ]
        }
      }
    }
  }
}
