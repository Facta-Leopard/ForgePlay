{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facta-leopard.github.io/ForgePlay/site-data/current-release.schema.json",
  "title": "ForgePlay current stable release",
  "description": "Machine-readable stable release metadata shared by the ForgePlay website and the app's update check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "product",
    "channel",
    "marketingVersion",
    "buildNumber",
    "releaseTag",
    "publishedAt",
    "minimumMacOSVersion",
    "releaseURL",
    "download"
  ],
  "properties": {
    "$schema": {
      "const": "./current-release.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "ForgePlay"
    },
    "channel": {
      "const": "stable"
    },
    "marketingVersion": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"
    },
    "buildNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "minimumMacOSVersion": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"
    },
    "releaseURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/Facta-Leopard/ForgePlay/releases/tag/"
    },
    "download": {
      "$ref": "#/$defs/download"
    }
  },
  "$defs": {
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetName",
        "url",
        "sha256",
        "byteSize"
      ],
      "properties": {
        "assetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/Facta-Leopard/ForgePlay/releases/download/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
