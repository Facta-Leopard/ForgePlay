--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -1033,7 +1033,7 @@
     {
         route->requested = wined3d;
         route->applied = wined3d;
-        route->reason = L"manual-session-wined3d-opengl";
+        route->reason = L"manual-session-wined3d-vulkan";
         route->supported = TRUE;
     }
     else if (!wcscmp( policy, L"vulkan" ))
@@ -1456,6 +1456,17 @@
         goto failed;
     for (i = 0; i < ARRAY_SIZE(variables); ++i)
     {
+        if (!wcscmp( route->applied, L"wined3d" ) &&
+            !wcscmp( variables[i].target_name, L"WINE_D3D_CONFIG" ))
+        {
+            /* Builtin WineD3D owns its backend choice. Preserve the same
+             * projection for descendants; base-helper restoration is separate. */
+            if ((status = set_forgeplay_renderer_literal( result,
+                    variables[i].target_name, L"renderer=vulkan" ))) goto failed;
+            if ((status = set_forgeplay_renderer_literal( result,
+                    variables[i].source_name, L"renderer=vulkan" ))) goto failed;
+            continue;
+        }
         status = set_forgeplay_renderer_environment_variable( result, variables[i].source_name,
