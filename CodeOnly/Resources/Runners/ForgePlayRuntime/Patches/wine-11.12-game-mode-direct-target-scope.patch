diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index b652c6b..215560c 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -453,6 +453,72 @@ static BOOL set_forgeplay_unix_environment_variable( const WCHAR *environment,
 }
 
 
+static BOOL forgeplay_game_mode_path_separator( WCHAR value )
+{
+    return value == L'/' || value == L'\\';
+}
+
+
+static BOOL forgeplay_game_mode_component_equal( const WCHAR *value, SIZE_T length,
+                                                  const char *expected )
+{
+    SIZE_T index;
+
+    if (!value || !expected || strlen( expected ) != length) return FALSE;
+    for (index = 0; index < length; ++index)
+    {
+        WCHAR left = value[index];
+        unsigned char right = expected[index];
+        if (left >= L'A' && left <= L'Z') left += L'a' - L'A';
+        if (right >= 'A' && right <= 'Z') right += 'a' - 'A';
+        if (left != right) return FALSE;
+    }
+    return TRUE;
+}
+
+
+/* ImagePathName is Wine's resolved executable identity. Every independently
+ * resolved executable in a Steam game tree can be the long-lived surface
+ * behind a launcher, so each eligible target enters the same fixed host.
+ * Shared redistributable infrastructure remains excluded. A Windows child
+ * cannot forge this Unix-only decision through its environment or command
+ * line, and the rule is independent of account, drive, volume, and title. */
+static BOOL forgeplay_game_mode_image_path_is_eligible( const UNICODE_STRING *image_path )
+{
+    const WCHAR *path, *end, *component;
+    SIZE_T length;
+    unsigned int stage = 0;
+    BOOL game_tree = FALSE;
+
+    if (!image_path || !image_path->Buffer || !image_path->Length) return FALSE;
+    path = image_path->Buffer;
+    end = path + image_path->Length / sizeof(WCHAR);
+    while (path < end)
+    {
+        while (path < end && forgeplay_game_mode_path_separator( *path )) ++path;
+        if (path == end) break;
+        component = path;
+        while (path < end && !forgeplay_game_mode_path_separator( *path )) ++path;
+        length = path - component;
+
+        if (forgeplay_game_mode_component_equal(
+                component, length, "_CommonRedist" )) return FALSE;
+        if (!stage && forgeplay_game_mode_component_equal(
+                component, length, "steamapps" ))
+            stage = 1;
+        else if (stage == 1 && forgeplay_game_mode_component_equal(
+                     component, length, "common" ))
+            stage = 2;
+        else if (stage == 1)
+            stage = forgeplay_game_mode_component_equal(
+                component, length, "steamapps" ) ? 1 : 0;
+        else if (stage == 2)
+            game_tree = TRUE;
+    }
+    return game_tree;
+}
+
+
