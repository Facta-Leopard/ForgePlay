+struct forgeplay_gl_framegen_creation_error
+{
+    uint32_t target;
+    char reason[64];
+};
+
+static void framegen_gl_creation_error_on_main(void *context)
+{
+    struct forgeplay_gl_framegen_creation_error *error = context;
+    framegen_record_error(error->target, error->reason);
+    free(error);
+}
+
+static void framegen_record_gl_creation_error(uint32_t target, const char *reason)
+{
+    static LONG queued;
+    struct forgeplay_gl_framegen_creation_error *error;
+
+    /* Reuse the existing main-executor, size-limited failure writer. Exactly
+     * one value-only delivery can be queued for all GL contexts in a process;
+     * renderer threads never wait for the main executor or file I/O. */
+    if (InterlockedCompareExchange(&queued, 1, 0)) return;
+    if (!(error = malloc(sizeof(*error)))) return;
+    error->target = target;
+    snprintf(error->reason, sizeof(error->reason), "%s", reason ? reason : "gl-session-create-failed");
+    dispatch_async_f(dispatch_get_main_queue(), error, framegen_gl_creation_error_on_main);
+}
+
+/* The caller is Wine's current OpenGL render context, before its original swap.
+ * No main-executor round trip is made on the per-frame capture boundary. */
+void *macdrv_framegen_create_opengl_session(void *view, void *cgl_context)
+{
+    struct forgeplay_framegen_configuration_v1 configuration;
+    const char *failure = NULL;
+    char reason[64] = {0};
+    void *session;
+
+    if (!framegen_requested_configuration(&configuration, &failure)) return NULL;
+    if (failure)
+    {
+        framegen_record_gl_creation_error(configuration.target_frame_rate, failure);
+        return NULL;
+    }
+    pthread_once(&framegen_load_once, framegen_load_proxy);
+    if (!framegen_gl_api)
+    {
+        framegen_record_gl_creation_error(configuration.target_frame_rate,
+            framegen_load_failure ? framegen_load_failure : "gl-proxy-entrypoint-missing");
+        return NULL;
+    }
+    session = framegen_gl_api->create_session(view, cgl_context, &configuration, reason, sizeof(reason));
+    if (!session)
+        framegen_record_gl_creation_error(configuration.target_frame_rate,
+            reason[0] ? reason : "gl-session-create-failed");
+    return session;
+}
+int macdrv_framegen_before_opengl_swap(void *session, uint32_t width, uint32_t height)
+{
+    return session && framegen_gl_api ? framegen_gl_api->before_swap(session, width, height) : 0;
+}
+void macdrv_framegen_destroy_opengl_session(void *session)
+{
+    if (session && framegen_gl_api) framegen_gl_api->destroy_session(session);
+}
