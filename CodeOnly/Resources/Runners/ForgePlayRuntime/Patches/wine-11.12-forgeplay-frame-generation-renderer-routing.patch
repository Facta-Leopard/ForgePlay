+
+void macdrv_framegen_report_offscreen_swapchain(void)
+{
+    struct forgeplay_framegen_configuration_v1 configuration;
+    const char *failure = NULL;
+
+    if (!framegen_requested_configuration( &configuration, &failure )) return;
+    /* A remote CAContext layer has no owning local WineMetalView. Keep its
+     * existing presentation path and report that interpolation is unavailable. */
+    macdrv_on_main_thread( (void *)^{
+        framegen_record_error( configuration.target_frame_rate,
+            failure ? failure : "cross-process-surface-unsupported" );
+    } );
+}
