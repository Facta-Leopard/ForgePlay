+struct forgeplay_framegen_error_snapshot
+{
+    char path[PATH_MAX];
+    char record[512];
+    size_t length;
+};
+
+static void framegen_write_error_snapshot( void *context )
+{
+    struct forgeplay_framegen_error_snapshot *snapshot = context;
+    struct stat metadata;
+    int descriptor;
+
+    descriptor = open( snapshot->path, O_WRONLY | O_APPEND | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK );
+    if (descriptor < 0) goto done;
+    if (!fstat( descriptor, &metadata ) && S_ISREG( metadata.st_mode ) &&
+        metadata.st_nlink == 1 && metadata.st_uid == geteuid() &&
+        metadata.st_size >= 0 && metadata.st_size < FORGEPLAY_FRAMEGEN_OBSERVATION_LIMIT &&
+        (size_t)metadata.st_size + snapshot->length <= FORGEPLAY_FRAMEGEN_OBSERVATION_LIMIT)
+        (void)write( descriptor, snapshot->record, snapshot->length );
+    close( descriptor );
+done:
+    free( snapshot );
+}
