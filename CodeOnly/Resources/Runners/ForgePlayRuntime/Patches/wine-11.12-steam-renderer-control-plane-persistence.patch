+/* Steam's standard redistributable installers live below steamapps/common,
+ * but they are infrastructure rather than game renderer processes. */
+static BOOL is_forgeplay_steam_common_redistributable_path( const WCHAR *path )
+{
+    const WCHAR *cursor;
+
+    if (!path) return FALSE;
+    for (cursor = path; *cursor; ++cursor)
+    {
+        if (*cursor != L'\\' && *cursor != L'/') continue;
+        if (!wcsnicmp( cursor + 1, L"_CommonRedist", 13 ) &&
+            (cursor[14] == L'\\' || cursor[14] == L'/')) return TRUE;
+    }
+    return FALSE;
+}
+
+
