#include "ForgePlayDefaults.xcconfig"

// This is a ForgePlay-owned Rosetta/Wine process component embedded inside
// the otherwise Apple Silicon-only app. It is not a supported Intel Mac host.
PRODUCT_NAME = ForgePlayExternalStorageAccess
EXECUTABLE_PREFIX =
EXECUTABLE_SUFFIX = .dylib
ARCHS = x86_64
ONLY_ACTIVE_ARCH = NO
MACH_O_TYPE = mh_dylib
SKIP_INSTALL = YES

CLANG_ENABLE_OBJC_ARC = YES
GCC_SYMBOLS_PRIVATE_EXTERN = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
OTHER_CFLAGS = $(inherited) -Wall -Wextra -Wpedantic
EXPORTED_SYMBOLS_FILE = $(SRCROOT)/Native/ExternalStorageAccessBridge/ExternalStorageAccessBridge.exports
STRIP_STYLE = non-global

DYLIB_INSTALL_NAME_BASE = @rpath
LD_DYLIB_INSTALL_NAME = @rpath/$(EXECUTABLE_NAME)
INSTALL_PATH = @rpath
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
