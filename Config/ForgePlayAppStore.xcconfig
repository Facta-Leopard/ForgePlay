#include "ForgePlayApp.xcconfig"

// App Store review candidate configuration. Keep Developer ID direct
// distribution entitlements in ForgePlayApp.xcconfig.
PRODUCT_BUNDLE_IDENTIFIER = $(FORGEPLAY_APP_STORE_BUNDLE_ID)
FORGEPLAY_GAME_MODE_APPLICATION_GROUP = $(DEVELOPMENT_TEAM).$(PRODUCT_BUNDLE_IDENTIFIER)
FORGEPLAY_REQUIRE_GAME_MODE_PRODUCTION_IDENTITY = YES
CODE_SIGN_ENTITLEMENTS = Sources/ForgePlay/ForgePlay-AppStore.entitlements
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) FORGEPLAY_APP_STORE
FORGEPLAY_BUNDLED_APPLE_GPTK_REDIST_MODE = excluded-commercial-app-store
