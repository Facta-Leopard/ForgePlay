#include "ForgePlayApp.xcconfig"

// Developer ID DMG distribution keeps the sandbox and App Group contract
// required by the fixed Game Mode process host.
PRODUCT_BUNDLE_IDENTIFIER = $(FORGEPLAY_DISTRIBUTION_BUNDLE_ID)
FORGEPLAY_GAME_MODE_APPLICATION_GROUP = $(DEVELOPMENT_TEAM).$(PRODUCT_BUNDLE_IDENTIFIER)
FORGEPLAY_REQUIRE_GAME_MODE_PRODUCTION_IDENTITY = YES
CODE_SIGN_ENTITLEMENTS = Sources/ForgePlay/ForgePlay-Distribution.entitlements
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) FORGEPLAY_SANDBOXED_DISTRIBUTION
FORGEPLAY_BUNDLED_APPLE_GPTK_REDIST_MODE = bundled-direct-dmg
