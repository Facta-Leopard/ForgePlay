#include "ForgePlayApp.xcconfig"

// The install-style Developer ID Release keeps product data in the user's
// normal Application Support directory. This App Group is used only for the
// fixed Game Mode process-host coordination boundary.
PRODUCT_BUNDLE_IDENTIFIER = $(FORGEPLAY_APP_BUNDLE_ID)
FORGEPLAY_GAME_MODE_APPLICATION_GROUP = $(DEVELOPMENT_TEAM).$(PRODUCT_BUNDLE_IDENTIFIER)
FORGEPLAY_REQUIRE_GAME_MODE_PRODUCTION_IDENTITY = YES
CODE_SIGN_ENTITLEMENTS = Sources/ForgePlay/ForgePlay-DirectRelease.entitlements
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
FORGEPLAY_BUNDLED_APPLE_GPTK_REDIST_MODE = bundled-direct-dmg
