#include "ForgePlayGameModeProcessHost.xcconfig"

// The outer direct Release app keeps its product data in the user's normal
// Application Support directory. Only fixed Game Mode IPC, evidence, and lease
// state use this exact App Group coordination boundary.
PRODUCT_BUNDLE_IDENTIFIER = $(FORGEPLAY_APP_BUNDLE_ID).game-mode-host
FORGEPLAY_GAME_MODE_APPLICATION_GROUP = $(DEVELOPMENT_TEAM).$(FORGEPLAY_APP_BUNDLE_ID)
FORGEPLAY_GAME_MODE_COORDINATION_PROFILE = direct-user-domain
FORGEPLAY_REQUIRE_GAME_MODE_PRODUCTION_IDENTITY = YES
CODE_SIGN_ENTITLEMENTS = Native/GameModeProcessHost/GameModeProcessHost-Release.entitlements
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
