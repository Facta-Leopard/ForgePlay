#include "ForgePlayDefaults.xcconfig"

// This ForgePlay-owned component runs only inside the bundled x86_64 Wine game
// process. The supported ForgePlay host remains Apple Silicon-only.
PRODUCT_NAME = ForgePlayD3DMetalFrameGenerationProxy
EXECUTABLE_PREFIX =
EXECUTABLE_SUFFIX = .dylib
ARCHS = x86_64
ONLY_ACTIVE_ARCH = NO
MACH_O_TYPE = mh_dylib
SKIP_INSTALL = YES

GCC_C_LANGUAGE_STANDARD = c17
CLANG_ENABLE_OBJC_ARC = YES
GCC_SYMBOLS_PRIVATE_EXTERN = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
OTHER_CFLAGS = $(inherited) -Wall -Wextra -Wpedantic
EXPORTED_SYMBOLS_FILE = $(SRCROOT)/Native/D3DMetalFrameGenerationProxy/ForgePlayD3DMetalFrameGenerationProxy.exports
STRIP_STYLE = non-global

DYLIB_INSTALL_NAME_BASE = @rpath
LD_DYLIB_INSTALL_NAME = @rpath/$(EXECUTABLE_NAME)
INSTALL_PATH = @rpath
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
