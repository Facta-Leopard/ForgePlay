#include "ForgePlayDefaults.xcconfig"

PRODUCT_NAME = ForgePlayNetworkControlHelper
PRODUCT_BUNDLE_IDENTIFIER = $(FORGEPLAY_APP_BUNDLE_ID).network-control-helper
INFOPLIST_FILE = Native/NetworkControlHelper/Info.plist
GENERATE_INFOPLIST_FILE = NO
